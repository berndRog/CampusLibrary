### ============================================================
### Reader 1: Erika Mustermann - 2 loans
### ============================================================

### @name Reader1_GetToken
POST {{authServer}}/connect/token
Content-Type: application/x-www-form-urlencoded
Accept: application/json

grant_type=dev_password
    &client_id={{devClientId}}
    &email={{reader1Email}}
    &password={{password}}
    &scope={{apiScope}}

> {%
    client.test("Reader 1 access token created", function() {
        client.assert(response.status === 200, "Expected HTTP 200");
        client.assert(!!response.body.access_token, "Missing access_token");
    });

    const token = response.body?.access_token;
    client.global.set("accessTokenReader1", token);
%}


### Reader 1 borrows Clean Code copy 1
POST {{baseUrl}}/loans
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessTokenReader1}}

{
  "id": "{{loan1Id}}",
  "readerId": "{{reader1Id}}",
  "bookItemId": "{{bookItem1Id}}"
}

> {%
    client.test("Reader 1 loan 1 created", function() {
        client.assert(response.status === 201, "Expected HTTP 201");
    });
%}


### Reader 1 borrows Domain-Driven Design copy 1
POST {{baseUrl}}/loans
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{accessTokenReader1}}

{
  "id": "{{loan2Id}}",
  "readerId": "{{reader1Id}}",
  "bookItemId": "{{bookItem5Id}}"
}

> {%
    client.test("Reader 1 loan 2 created", function() {
        client.assert(response.status === 201, "Expected HTTP 201");
    });
%}


