@baseUrl = http://localhost:5000/library/v1

### 
# create reader 1
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "firstname": "Erika",
  "lastname": "Mustermann",
  "email": "e.mustermann@t-online.de",
  "addressDto": {
    "street": "Hauptstr. 12",
    "postalCode": "29556",
    "city": "Suderburg",
    "country": "DE"
  },
  "subject": "reader-001",
  "id": "10000000-0000-0000-0000-000000000000"
}

###
# create reader 2
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "firstname": "Max",
  "lastname": "Mustermann",
  "email": "m.mustermann@gmail.com",
  "addressDto": {
    "street": "Hauptstr. 12",
    "postalCode": "29556",
    "city": "Suderburg",
    "country": "DE"
  },
  "subject": "reader-002",
  "id": "20000000-0000-0000-0000-000000000000"
}

###
#
POST {{baseUrl}}/readers
Content-Type: application/json
