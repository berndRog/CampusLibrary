  "firstname": "A",
  "lastname": "Mustermann",
  "email": "reader005@example.com",
  "addressDto": {
    "street": "Musterstraße 12",
    "postalCode": "12345",
    "city": "Musterstadt",
    "country": "DE"
  },
  "id": null
}


### Create reader with invalid id
### Expected: 400 Bad Request
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "subject": "reader-006",
  "firstname": "Max",
  "lastname": "Mustermann",
  "email": "reader006@example.com",
  "addressDto": {
    "street": "Musterstraße 12",
    "postalCode": "12345",
    "city": "Musterstadt",
    "country": "DE"
  },
  "id": "not-a-guid"
}


### Create reader with invalid email
### Expected: 400 Bad Request
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "subject": "reader-007",
  "firstname": "Max",
  "lastname": "Mustermann",
  "email": "not-an-email",
  "addressDto": {
    "street": "Musterstraße 12",
    "postalCode": "12345",
    "city": "Musterstadt",
    "country": "DE"
  },
  "id": null
}


### Update reader with invalid lastname
### Expected: 400 Bad Request
PUT {{baseUrl}}/readers/{{reader2Id}}
Content-Type: application/json
Accept: application/json

{
  "lastname": "",
  "email": null,
  "addressDto": null
}


### Update unknown reader
### Expected: 404 Not Found
PUT {{baseUrl}}/readers/{{unknownReaderId}}
Content-Type: application/json
Accept: application/json

{
  "lastname": "Unknown",
  "email": null,
  "addressDto": null
}


### Update reader with duplicate email
### Existing email: e.meier@gmx.de
### Expected: 409 Conflict
PUT {{baseUrl}}/readers/{{reader2Id}}
Content-Type: application/json
Accept: application/json

{
  "lastname": null,
  "email": "e.meier@gmx.de",
  "addressDto": null
}


### 7. Destructive deactivation tests =========================================
### Run these last.
### They change the database state.


### Deactivate reader 1
### Expected:
### - 204 No Content
### - Reader remains stored in the database.
### - Reader disappears from normal read model queries.
### - Reader is still visible through with-inactive endpoints.
DELETE {{baseUrl}}/readers/{{reader1Id}}
Accept: application/json


### Get deactivated reader 1 by normal id endpoint
### Expected: 404 Not Found
GET {{baseUrl}}/readers/{{reader1Id}}
Accept: application/json


### Get deactivated reader 1 including inactive readers
### Expected: 200 OK with isActive = false
GET {{baseUrl}}/readers/{{reader1Id}}/with-inactive
Accept: application/json


### Get all active readers after deactivation
### Expected: 200 OK without reader 1
GET {{baseUrl}}/readers
Accept: application/json


### Get all readers including inactive readers after deactivation
### Expected: 200 OK with reader 1 and isActive = false
GET {{baseUrl}}/readers/with-inactive
Accept: application/json


### Deactivate already inactive reader
### Expected: 409 Conflict
DELETE {{baseUrl}}/readers/{{reader1Id}}
Accept: application/json


### Deactivate unknown reader
### Expected: 404 Not Found
DELETE {{baseUrl}}/readers/{{unknownReaderId}}
Accept: application/json


### Deactivate invalid id
### Expected: 404 Not Found by routing because "not-a-guid" does not match {id:guid}
DELETE {{baseUrl}}/readers/not-a-guid
Accept: application/json
