@baseUrl = https://localhost:8010/camplib/v1

### ============================================================
### Readers API
### Seed-based manual API test
### ============================================================
###
### Important:
### The database should be deleted/reset before running this file.
### This file creates reproducible Reader demo data through the public API.
###
### Current Readers behavior:
### - Normal read endpoints return only active readers.
### - Deactivate does not physically delete a reader.
### - Deactivated readers are hidden from normal read model queries.
### - Deactivated readers remain visible through with-inactive endpoints.
###
### Run the destructive deactivation block near the end.
### ============================================================

@reader1Id = 10000000-0000-0000-0000-000000000000
@reader2Id = 20000000-0000-0000-0000-000000000000
@unknownReaderId = 99999999-9999-9999-9999-999999999999

@reader1Subject = reader-001
@reader2Subject = reader-002
@reader3Subject = reader-003

@reader1Email = e.mustermann@t-online.de
@reader2Email = m.mustermann@gmail.com
@reader3Email = a.arndt@t-online.de


### 1. Create seed readers =====================================================

### Create reader 1: Erika Mustermann
### Expected: 201 Created
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "firstname": "Erika",
  "lastname": "Mustermann",
  "email": "{{reader1Email}}",
  "addressDto": {
    "street": "Hauptstr. 12",
    "postalCode": "29556",
    "city": "Suderburg",
    "country": "DE"
  },
  "subject": "{{reader1Subject}}",
  "id": "{{reader1Id}}"
}


### Create reader 2: Max Mustermann
### Expected: 201 Created
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "firstname": "Max",
  "lastname": "Mustermann",
  "email": "{{reader2Email}}",
  "addressDto": {
    "street": "Hauptstr. 12",
    "postalCode": "29556",
    "city": "Suderburg",
    "country": "DE"
  },
  "subject": "{{reader2Subject}}",
  "id": "{{reader2Id}}"
}


### Create reader 3 with generated id: Arne Arndt
### Expected: 201 Created
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "firstname": "Arne",
  "lastname": "Arndt",
  "email": "{{reader3Email}}",
  "addressDto": {
    "street": "Neuperverstr. 29",
    "postalCode": "29410",
    "city": "Salzwedel",
    "country": "DE"
  },
  "subject": "{{reader3Subject}}",
  "id": null
}


### 2. Verify active readers ==================================================

### Get all active readers
### Expected: 200 OK with reader 1, reader 2 and reader 3
GET {{baseUrl}}/readers
Accept: application/json


### Get all readers including inactive readers
### Expected: 200 OK with reader 1, reader 2 and reader 3
GET {{baseUrl}}/readers/with-inactive
Accept: application/json


### Get active reader 1 by id
### Expected: 200 OK
GET {{baseUrl}}/readers/{{reader1Id}}
Accept: application/json


### Get active reader 2 by id
### Expected: 200 OK
GET {{baseUrl}}/readers/{{reader2Id}}
Accept: application/json


### Get reader 1 by id including inactive readers
### Expected: 200 OK
GET {{baseUrl}}/readers/{{reader1Id}}/with-inactive
Accept: application/json


### Get reader 1 by email
### Expected: 200 OK
GET {{baseUrl}}/readers/email?email={{reader1Email}}
Accept: application/json


### Get reader 2 by email
### Expected: 200 OK
GET {{baseUrl}}/readers/email?email={{reader2Email}}
Accept: application/json


### 3. Update reader ===========================================================

### Update reader 1
### Expected: 200 OK
PUT {{baseUrl}}/readers/{{reader1Id}}
Content-Type: application/json
Accept: application/json

{
  "lastname": "Meier",
  "email": "e.meier@gmx.de",
  "addressDto": {
    "street": "Neue Straße 5",
    "postalCode": "30123",
    "city": "Hannover",
    "country": "DE"
  }
}


### Get updated active reader 1 by id
### Expected: 200 OK with lastname Meier and email e.meier@gmx.de
GET {{baseUrl}}/readers/{{reader1Id}}
Accept: application/json


### Get updated reader 1 by new email
### Expected: 200 OK
GET {{baseUrl}}/readers/email?email=e.meier@gmx.de
Accept: application/json


### Get reader 1 by old email
### Expected: 404 Not Found
GET {{baseUrl}}/readers/email?email={{reader1Email}}
Accept: application/json


### 4. Negative read tests before deactivation =================================

### Get unknown reader by id
### Expected: 404 Not Found
GET {{baseUrl}}/readers/{{unknownReaderId}}
Accept: application/json


### Get unknown reader by id including inactive readers
### Expected: 404 Not Found
GET {{baseUrl}}/readers/{{unknownReaderId}}/with-inactive
Accept: application/json


### Get reader by unknown email
### Expected: 404 Not Found
GET {{baseUrl}}/readers/email?email=unknown@example.com
Accept: application/json


### Get reader by invalid email
### Expected: 400 Bad Request
GET {{baseUrl}}/readers/email?email=invalid-email
Accept: application/json


### 5. Conflict tests ==========================================================

### Create reader with duplicate subject
### Existing subject: reader-002
### Expected: 409 Conflict
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "subject": "{{reader2Subject}}",
  "firstname": "Erika",
  "lastname": "Meier",
  "email": "duplicate.subject@example.com",
  "addressDto": {
    "street": "Neue Straße 1",
    "postalCode": "11111",
    "city": "Teststadt",
    "country": "DE"
  },
  "id": null
}


### Create reader with duplicate email
### Existing email: m.mustermann@gmail.com
### Expected: 409 Conflict
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "subject": "reader-004",
  "firstname": "Erika",
  "lastname": "Meier",
  "email": "{{reader2Email}}",
  "addressDto": {
    "street": "Neue Straße 1",
    "postalCode": "11111",
    "city": "Teststadt",
    "country": "DE"
  },
  "id": null
}


