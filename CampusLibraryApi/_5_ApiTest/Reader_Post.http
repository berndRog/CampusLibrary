@baseUrl = https://localhost:8010/camplib/v1


@reader1Id = 00000001-0000-0000-0000-000000000000
@reader2Id = 00000002-0000-0000-0000-000000000000
@reader3Id = 00000003-0000-0000-0000-000000000000
@reader99Id = 00000099-0000-0000-0000-000000000000

@reader1Subject = reader-001
@reader2Subject = reader-002
@reader3Subject = reader-003
@reader99Subject = reader-099

@reader1Email = e.mustermann@t-online.de
@reader2Email = m.mustermann@gmail.com
@reader3Email = a.arndt@t-online.de
@reader99Email = r.reader@library.local


### 1. Create seed readers =====================================================

### Create reader 1: Erika Mustermann
### Expected: 201 Created
POST {{baseUrl}}/readers
Content-Type: application/json
Accept: application/json

{
  "firstname": "Erika",
  "lastname": "Mustermann",
  "email": "{{reader1Email}}",
  "addressDto": {
    "street": "Hauptstr. 12",
    "postalCode": "29556",
    "city": "Suderburg",
    "country": "DE"
  },
  "subject": "{{reader1Subject}}",
  "id": "{{reader1Id}}"
}


