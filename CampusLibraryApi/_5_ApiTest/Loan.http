@baseUrl = https://localhost:8010/camplib/v1

### ============================================================
### Loans API
### Seed-based manual API test
### ============================================================
###
### Important:
### The database should be deleted/reset before running this file.
###
### Run order:
### 1. Readers.http
### 2. Books.http
### 3. Loans.http
###
### This file assumes:
### - Readers already exist.
### - Books and BookItems already exist.
###
### Current Loans behavior:
### - A stored Loan represents a current borrowing.
### - Returning an item at the desk deletes the Loan.
### - LoanStatus and ReturnedAt are intentionally not stored.
###
### Current routes:
### - GET   /loans
### - GET   /loans/{id}
### - POST  /loans
### - PATCH /loans/{id}/renew
### - PATCH /loans/{id}/return-at-desk
###
### There is intentionally no /loans/active route.
### ============================================================


### Reader ids from Readers.http =============================================

@reader1Id = 00000001-0000-0000-0000-000000000000
@reader2Id = 00000002-0000-0000-0000-000000000000
@unknownReaderId = 00000999-0000-0000-0000-000000000000


### BookItem ids from Books.http =============================================

@bookItem1Id = 00000001-0000-0000-0000-000000000000
@bookItem2Id = 00000002-0000-0000-0000-000000000000
@bookItem3Id = 00000003-0000-0000-0000-000000000000
@bookItem4Id = 00000004-0000-0000-0000-000000000000
@unknownBookItemId = 00000999-0000-0000-0000-000000000000


### Loan ids =================================================================

@loan1Id = 00000001-0000-0000-0000-000000000000
@loan2Id = 00000002-0000-0000-0000-000000000000
@loan3Id = 00000003-0000-0000-0000-000000000000
@duplicateLoanId = 00000009-0000-0000-0000-000000000000
@unknownLoanId = 00000999-0000-0000-0000-000000000000


### 1. Verify empty loans collection ==========================================

### Get borrowed loans before borrowing
### Expected: 200 OK with empty list
GET {{baseUrl}}/loans
Accept: application/json


### Get unknown loan by id
### Expected: 404 Not Found
GET {{baseUrl}}/loans/{{unknownLoanId}}
Accept: application/json


### Get invalid loan id
### Expected: 404 Not Found by routing because "not-a-guid" does not match {id:guid}
GET {{baseUrl}}/loans/not-a-guid
Accept: application/json



### 3. Verify borrowed loans ===================================================

### Get loan 1 by id
### Expected: 200 OK
### Expected detail data:
### - reader data is included
### - book item data is included
### - isOverdue = false
### - canRenew = true
GET {{baseUrl}}/loans/{{loan1Id}}
Accept: application/json


### Get all borrowed loans
### Expected: 200 OK
### Expected:
### - loan1, loan2 and loan3 are included
GET {{baseUrl}}/loans
Accept: application/json


### 4. Conflict tests ==========================================================

### Borrow already borrowed BookItem 1 again
### Expected: 409 Conflict
POST {{baseUrl}}/loans
Content-Type: application/json
Accept: application/json

{
  "id": "{{duplicateLoanId}}",
  "readerId": "{{reader1Id}}",
  "bookItemId": "{{bookItem1Id}}"
}


### 5. Negative borrow tests ===================================================

### Borrow for unknown reader
### Expected: 404 Not Found
POST {{baseUrl}}/loans
Content-Type: application/json
Accept: application/json

{
  "id": null,
  "readerId": "{{unknownReaderId}}",
  "bookItemId": "{{bookItem2Id}}"
}


### Borrow unknown BookItem
### Expected: 404 Not Found
POST {{baseUrl}}/loans
Content-Type: application/json
Accept: application/json

{
  "id": null,
  "readerId": "{{reader1Id}}",
  "bookItemId": "{{unknownBookItemId}}"
}


### Borrow with empty reader id
### Expected: 400 Bad Request
POST {{baseUrl}}/loans
Content-Type: application/json
Accept: application/json

{
  "id": null,
  "readerId": "00000000-0000-0000-0000-000000000000",
  "bookItemId": "{{bookItem2Id}}"
}


### Borrow with empty book item id
### Expected: 400 Bad Request
POST {{baseUrl}}/loans
Content-Type: application/json
Accept: application/json

{
  "id": null,
  "readerId": "{{reader1Id}}",
  "bookItemId": "00000000-0000-0000-0000-000000000000"
}


### Borrow with invalid loan id
### Expected: 400 Bad Request
POST {{baseUrl}}/loans
Content-Type: application/json
Accept: application/json

{
  "id": "not-a-guid",
  "readerId": "{{reader1Id}}",
  "bookItemId": "{{bookItem2Id}}"
}


### 6. Renew loan =============================================================

### Renew borrowed loan 1
### Expected: 200 OK
### Expected:
### - renewalCount = 1
### - dueDate is extended by LoanRules.StandardRenewalDays
PATCH {{baseUrl}}/loans/{{loan1Id}}/renew
Accept: application/json


### Get renewed loan 1 by id
### Expected: 200 OK
### Expected:
### - renewalCount = 1
### - canRenew = true if max renewals is not reached
GET {{baseUrl}}/loans/{{loan1Id}}
Accept: application/json


### Renew unknown loan
### Expected: 404 Not Found
PATCH {{baseUrl}}/loans/{{unknownLoanId}}/renew
Accept: application/json


### Renew invalid loan id
### Expected: 404 Not Found by routing because "not-a-guid" does not match {id:guid}
PATCH {{baseUrl}}/loans/not-a-guid/renew
Accept: application/json


### 7. Return loan at desk =====================================================
### Run these after the renew tests.
### Returning loan 1 deletes the Loan.


### Return loan 1 at desk
### Expected: 204 No Content
### The Loan is deleted from the database.
PATCH {{baseUrl}}/loans/{{loan1Id}}/return-at-desk
Accept: application/json


### Get returned loan 1 by id
### Expected: 404 Not Found because the Loan was deleted
GET {{baseUrl}}/loans/{{loan1Id}}
Accept: application/json


### Get all borrowed loans after returning loan 1
### Expected: 200 OK
### Expected:
### - loan1 is no longer included
### - loan2 and loan3 are still included
GET {{baseUrl}}/loans
Accept: application/json


### Return the already deleted loan 1 again
### Expected: 404 Not Found
PATCH {{baseUrl}}/loans/{{loan1Id}}/return-at-desk
Accept: application/json


### Renew the already deleted loan 1
### Expected: 404 Not Found
PATCH {{baseUrl}}/loans/{{loan1Id}}/renew
Accept: application/json


### Return unknown loan
### Expected: 404 Not Found
PATCH {{baseUrl}}/loans/{{unknownLoanId}}/return-at-desk
Accept: application/json


### Return invalid loan id
### Expected: 404 Not Found by routing because "not-a-guid" does not match {id:guid}
PATCH {{baseUrl}}/loans/not-a-guid/return-at-desk
Accept: application/json