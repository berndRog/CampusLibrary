### 1. Create seed books =======================================================

### Create seed book 1: Clean Code
POST {{baseUrl}}/books
Content-Type: application/json
Accept: application/json

{
  "authorsText": "Robert C. Martin",
  "title": "Clean Code",
  "subtitle": "A Handbook of Agile Software Craftsmanship",
  "isbn": "{{book1Isbn}}",
  "id": "{{book1Id}}"
}


### Create seed book 2: Domain-Driven Design
POST {{baseUrl}}/books
Content-Type: application/json
Accept: application/json

{
  "authorsText": "Eric Evans",
  "title": "Domain-Driven Design",
  "subtitle": "Tackling Complexity in the Heart of Software",
  "isbn": "{{book2Isbn}}",
  "id": "{{book2Id}}"
}


### Create seed book 3: Refactoring
POST {{baseUrl}}/books
Content-Type: application/json
Accept: application/json

{
  "authorsText": "Martin Fowler, Kent Beck",
  "title": "Refactoring",
  "subtitle": "Improving the Design of Existing Code",
  "isbn": "{{book3Isbn}}",
  "id": "{{book3Id}}"
}


### Create seed book 4: Design Patterns
POST {{baseUrl}}/books
Content-Type: application/json
Accept: application/json

{
  "authorsText": "Erich Gamma, Richard Helm, Ralph Johnson, John Vlissides",
  "title": "Design Patterns",
  "subtitle": "Elements of Reusable Object-Oriented Software",
  "isbn": "{{book4Isbn}}",
  "id": "{{book4Id}}"
}


### Create seed book 5: C# in Depth
POST {{baseUrl}}/books
Content-Type: application/json
Accept: application/json

{
  "authorsText": "Jon Skeet",
  "title": "C# in Depth",
  "subtitle": "Fourth Edition",
  "isbn": "{{book5Isbn}}",
  "id": "{{book5Id}}"
}


### Create seed book 6: C# 13 and .NET 9
POST {{baseUrl}}/books
Content-Type: application/json
Accept: application/json

{
  "authorsText": "Mark J. Price",
  "title": "C# 13 and .NET 9",
  "subtitle": "Modern Cross-Platform Development Fundamentals",
  "isbn": "{{book6Isbn}}",
  "id": "{{book6Id}}"
}


### Create seed book 7: Patterns of Enterprise Application Architecture
POST {{baseUrl}}/books
Content-Type: application/json
Accept: application/json

{
  "authorsText": "Martin Fowler",
  "title": "Patterns of Enterprise Application Architecture",
  "subtitle": null,
  "isbn": "{{book7Isbn}}",
  "id": "{{book7Id}}"
}


### Create seed book 8: The Pragmatic Programmer
POST {{baseUrl}}/books
Content-Type: application/json
Accept: application/json

{
  "authorsText": "David Thomas, Andrew Hunt",
  "title": "The Pragmatic Programmer",
  "subtitle": "Your Journey to Mastery",
  "isbn": "{{book8Isbn}}",
  "id": "{{book8Id}}"
}


