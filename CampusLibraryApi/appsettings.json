{
  "ConnectionStrings": {
    "CampusLibraryDb": "Data Source=CampusLibraryDb.db"
  },

  "IdentityAccessServer": {
    "Authority": "https://localhost:7010",
    "Audience": "campus-library-api",
    "RequireHttpsMetadata": false,
    "ValidateAudience": true,
    "ClockSkewSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:6040",
      "http://localhost:6041"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"

}
