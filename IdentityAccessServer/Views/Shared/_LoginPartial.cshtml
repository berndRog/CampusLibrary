@using Microsoft.AspNetCore.Identity
@using IdentityAccessServer.Data
@using IdentityAccessServer.Infrastructure.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
  // Preserve the OIDC return URL while the user moves between Identity pages.
  //
  // During an authorization-code flow the login page is opened with a URL like:
  // /Identity/Account/Login?ReturnUrl=/connect/authorize?...
  //
  // Losing this value would turn the login into a standalone Identity login.
  // The user would then be redirected to "/" instead of back to the OIDC
  // authorization endpoint and finally to the CampusLibrary client.
  string returnUrl = Context.Request.Query["returnUrl"].ToString();

  if (string.IsNullOrWhiteSpace(returnUrl))
    returnUrl = Context.Request.Query["ReturnUrl"].ToString();

  string? currentPage = ViewContext.RouteData.Values["page"]?.ToString();

  bool isLoginPage = string.Equals(
    currentPage,
    "/Account/Login",
    StringComparison.OrdinalIgnoreCase
  );
}

<ul class="navbar-nav">
  @if (SignInManager.IsSignedIn(User))
  {
    var currentUser = await UserManager.GetUserAsync(User);
    var canRegisterEmployees = currentUser?.AccountType == "employee"
      && (currentUser.AdminRights & AdminRights.ManageEmployees) == AdminRights.ManageEmployees;
    var canRegisterCustomers = currentUser?.AccountType == "employee"
      && (currentUser.AdminRights & AdminRights.ManageCustomers) == AdminRights.ManageCustomers;

    <li class="nav-item">
      <span class="nav-link text-dark">Hello @User.Identity?.Name!</span>
    </li>
    @if (canRegisterCustomers)
    {
      <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/RegisterCustomer">Register customer</a>
      </li>
    }
    @if (canRegisterEmployees)
    {
      <li class="nav-item">
        <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/RegisterEmployee">Register employee</a>
      </li>
    }
    <li class="nav-item">
      <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
        <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
      </form>
    </li>
  }
  else if (!isLoginPage)
  {
    <li class="nav-item">
      <a
        class="nav-link text-dark"
        asp-area="Identity"
        asp-page="/Account/Login"
        asp-route-returnUrl="@(string.IsNullOrWhiteSpace(returnUrl) ? null : returnUrl)">
        Login
      </a>
    </li>
  }
</ul>
