<Router AppAssembly="typeof(Program).Assembly">
   <Found Context="routeData">
      @* Part 6: AuthorizeRouteView evaluates [Authorize] attributes on routable pages.
         API client hardening and deeper API/use-case authorization continue in Part 7. *@
      @if(_authNEnabled) {
         <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
               <p>Du bist nicht berechtigt, diese Seite aufzurufen.</p>
               <p><a href="/identity/login?returnUrl=%2Fentry" data-enhance-nav="false">Anmelden</a></p>
            </NotAuthorized>
         </AuthorizeRouteView>
      }
      else {
         <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
      }
      <FocusOnNavigate RouteData="routeData" Selector="h1" />
   </Found>
   <NotFound>
      <PageTitle>Nicht gefunden</PageTitle>
      <LayoutView Layout="typeof(MainLayout)">
         <h1>Seite nicht gefunden</h1>
         <p>Die angeforderte Seite existiert nicht.</p>
      </LayoutView>
   </NotFound>
</Router>

@code {

   [Inject]
   private IConfiguration Configuration { get; set; } = default!;

   private bool _authNEnabled;

   protected override void OnInitialized() {
      _authNEnabled = Configuration.GetValue<bool>(FeatureFlags.AuthNEnabled);
   }
}
