<Router AppAssembly="typeof(Program).Assembly">
   <Found Context="routeData">
      @* Teil 5: normales Routing ohne aktive Autorisierungsprüfung in der UI. *@
      @if(_authNEnabled) {
         <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
               <p>Du bist nicht berechtigt, diese Seite aufzurufen.</p>
               <p><a href="/identity/login?returnUrl=%2Fentry">Anmelden</a></p>
            </NotAuthorized>
         </AuthorizeRouteView>
      }
      else {
         <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
      }
      <FocusOnNavigate RouteData="routeData" Selector="h1" />
   </Found>
   <NotFound>
      <PageTitle>Nicht gefunden</PageTitle>
      <LayoutView Layout="typeof(MainLayout)">
         <h1>Seite nicht gefunden</h1>
         <p>Die angeforderte Seite existiert nicht.</p>
      </LayoutView>
   </NotFound>
</Router>

@code {

   [Inject]
   private IConfiguration Configuration { get; set; } = default!;

   private bool _authNEnabled;

   protected override void OnInitialized() {
      _authNEnabled = Configuration.GetValue<bool>(FeatureFlags.AuthNEnabled);
   }
}
