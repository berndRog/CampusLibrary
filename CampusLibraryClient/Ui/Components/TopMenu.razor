@inject ICurrentUserProvider CurrentUserProvider
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<nav class="navbar navbar-expand-sm navbar-light bg-light border-top border-bottom pe-2 ps-0">
   <button class="navbar-toggler ms-auto"
           type="button"
           data-bs-toggle="collapse"
           data-bs-target="#topmenu"
           aria-controls="topmenu"
           aria-expanded="false"
           aria-label="Navigation umschalten">
      <span class="navbar-toggler-icon"></span>
   </button>

   <div class="collapse navbar-collapse" id="topmenu">
      @if(_currentUser is null) {
         <span class="navbar-text">Navigation wird geladen...</span>
      }
      else {
         <ul class="navbar-nav me-auto nav-pills">
            <li class="nav-item">
               <NavLink class="nav-link"
                        href="/"
                        Match="NavLinkMatch.All"
                        ActiveClass="active text-white">
                  Home
               </NavLink>
            </li>

            @if(_currentUser.IsReader || _currentUser.IsEmployee) {
               <li class="nav-item">
                  <NavLink class="nav-link"
                           href="/catalog/books"
                           ActiveClass="active text-white">
                     Katalog
                  </NavLink>
               </li>
            }

            @if(_currentUser.IsReader) {
               <li class="nav-item">
                  <NavLink class="nav-link"
                           href="/loans/me"
                           ActiveClass="active text-white">
                     Ausleihen
                  </NavLink>
               </li>

               <li class="nav-item">
                  <NavLink class="nav-link"
                           href="/readers/update"
                           ActiveClass="active text-white">
                     Ändern
                  </NavLink>
               </li>
            }

            @if(_currentUser.IsEmployee) {
               <li class="nav-item">
                  <NavLink class="nav-link"
                           href="/readers"
                           ActiveClass="active text-white">
                     Leser
                  </NavLink>
               </li>

               <li class="nav-item">
                  <NavLink class="nav-link"
                           href="/loans"
                           ActiveClass="active text-white">
                     Ausleihen
                  </NavLink>
               </li>
            }

            @if((_currentUser.IsReader || _currentUser.IsEmployee) && _authNEnabled) {
               <li class="nav-item">
                  <NavLink class="nav-link"
                           href="/auth/details"
                           ActiveClass="active text-white">
                     Auth Details
                  </NavLink>
               </li>

               <li class="nav-item">
                  <NavLink class="nav-link"
                           href="/auth/routes"
                           ActiveClass="active text-white">
                     Routen
                  </NavLink>
               </li>
            }
         </ul>

         <div class="d-flex align-items-sm-center gap-2 flex-column flex-sm-row ms-sm-auto mt-2 mt-sm-0">
            @if(_currentUser.IsAuthenticated) {
               <span class="navbar-text small text-muted">
                  @_currentUser.DisplayName (@DisplayAccountType(_currentUser.AccountType))
               </span>

               <a class="btn btn-outline-danger btn-sm" href="@LogoutUrl" data-enhance-nav="false">
                  Logout
               </a>
            }
            else {
               @if(_authNEnabled) {
                  <a class="btn btn-primary btn-sm" href="@LoginUrl" data-enhance-nav="false">
                     Login
                  </a>
               }
               else {
                  <span class="btn btn-outline-secondary btn-sm disabled" aria-disabled="true">
                     Login
                  </span>
               }
            }
         </div>
      }
   </div>
</nav>

@code {

   private CurrentUserInfo? _currentUser;

   private bool _authNEnabled;

   protected override async Task OnInitializedAsync() {
      _authNEnabled = Configuration.GetValue<bool>(FeatureFlags.AuthNEnabled);
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
   }

   private string LoginUrl =>
      "/identity/login?returnUrl=" + Uri.EscapeDataString("/entry");

   private string LogoutUrl => _authNEnabled
      ? "/identity/logout"
      : "/logout";

   private static string DisplayAccountType(
      string? accountType
   ) => accountType?.ToLowerInvariant() switch {
      "reader" => "Leser/in",
      "employee" => "Mitarbeiter/in",
      _ => accountType ?? "unbekannt"
   };
}

@* Part 6:
   Routable pages use simple role checks: Reader or Employee.
   The menu mirrors those roles so anonymous users only see the login entry.

   Login goes to /entry so that the client can provision the fachlicher Reader
   before normal reader pages are shown.

   /readers/profile is intentionally NOT part of the menu. It is a mandatory
   profile-completion page that is reached only from the provisioning flow.

   /readers/update is the normal self-service page for later reader data changes.

   /auth/details and /auth/routes are teaching/debug pages. They are visible in
   the menu for authenticated users while AuthN is enabled, because Part 6
   explicitly teaches OpenID Connect, OAuth, tokens, .NET cookies, claims
   processing and page-level authorization.
*@
