@inject ICurrentUserProvider CurrentUserProvider

<div class="top-menu">
   @if(_currentUser is null) {
      <span>Loading user...</span>
   }
   else if(_currentUser.IsAuthenticated) {
      <span>
         @_currentUser.DisplayName
         (@_currentUser.AccountType)
      </span>

      @if(!_authNEnabled) {
         <span class="muted">DevIdentity, no real login</span>
      }
      else {
         <a href="/identity/logout">Logout</a>
      }
   }
   else {
      <span>Anonymous</span>

      @if(_authNEnabled) {
         <a href="/identity/login?returnUrl=%2Fentry">Login</a>
      }
      else {
         <span class="muted">Part 5: no active authentication</span>
      }
   }
</div>

@code {

   [Inject]
   private IConfiguration Configuration { get; set; } = default!;

   private CurrentUserInfo? _currentUser;

   private bool _authNEnabled;

   protected override async Task OnInitializedAsync() {
      _authNEnabled = Configuration.GetValue<bool>(FeatureFlags.AuthNEnabled);
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
   }
}

@* Part 6 preparation:
   When AuthNEnabled=true, the same TopMenu can use ClaimsCurrentUserProvider.
   The UI still asks ICurrentUserProvider, so the DevIdentity source can be
   removed without rewriting the pages.
*@
