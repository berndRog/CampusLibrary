@page "/readers"
@rendermode InteractiveServer
@inherits BasePage
@* Part 8: protect this page with [Authorize(Policy = CampusLibraryPolicies.CanManageReaders)]. *@

@inject IReaderClient ReaderClient
@inject ICurrentUserProvider CurrentUserProvider

<PageTitle>Leser</PageTitle>

<h1 class="h3 mb-3">Leser</h1>

<p class="text-muted">
   Mitarbeiteransicht. Leserinnen und Leser werden von Bibliotheksmitarbeitenden verwaltet.
</p>

<button class="btn btn-outline-secondary mb-3" @onclick="LoadAsync">Neu laden</button>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p class="text-muted">Leser werden geladen...</p>
}
else if(!_currentUser.IsEmployee) {
   <p>Diese Seite ist für Mitarbeitende vorgesehen.</p>
}
else if(_readers.Count == 0) {
   <p>Keine Leser gefunden.</p>
}
else {
   <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
         <thead class="table-light">
            <tr>
               <th scope="col">Vorname</th>
               <th scope="col">Nachname</th>
               <th scope="col">E-Mail</th>
               <th scope="col">Subject</th>
               <th scope="col">Status</th>
            </tr>
         </thead>
         <tbody>
            @foreach(ReaderDto reader in _readers) {
               <tr>
                  <td>@reader.Firstname</td>
                  <td>@reader.Lastname</td>
                  <td>@reader.Email</td>
                  <td><code>@reader.Subject</code></td>
                  <td>
                     @if(reader.IsActive) {
                        <span class="badge text-bg-success">Aktiv</span>
                     }
                     else {
                        <span class="badge text-bg-secondary">Inaktiv</span>
                     }
                  </td>
               </tr>
            }
         </tbody>
      </table>
   </div>
}

@code {

   private IReadOnlyList<ReaderDto> _readers = [];

   private CurrentUserInfo? _currentUser;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();
      Error = null;

      Result<IEnumerable<ReaderDto>> result = await ReaderClient.GetAllAsync();

      if(result.IsSuccess && result.Value is not null)
         _readers = result.Value.ToList();
      else
         Error = result.Error;

      StopLoading();
   }
}
