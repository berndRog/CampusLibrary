@page "/readers"
@attribute [Authorize(Roles = CampusLibraryRoles.Employee)]
@rendermode InteractiveServer
@inherits BasePage
@* Part 6: employee page for viewing readers and opening reader details. *@

@inject IReaderClient ReaderClient
@inject ICurrentUserProvider CurrentUserProvider

<PageTitle>Leser</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
   <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@IsLoading">
      Neu laden
   </button>

   <div class="form-check mb-0">
      <input id="includeInactive"
             type="checkbox"
             class="form-check-input"
             @bind="_includeInactive" />
      <label class="form-check-label" for="includeInactive">
         Inaktive Leser einbeziehen
      </label>
   </div>
</div>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p class="text-muted">Leser werden geladen...</p>
}
else if(!_currentUser.IsEmployee) {
   <p>Diese Seite ist für Mitarbeitende vorgesehen.</p>
}
else if(_readers.Count == 0) {
   <p>Keine Leser gefunden.</p>
}
else {
   <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
         <thead class="table-light">
            <tr>
               <th scope="col">Vorname</th>
               <th scope="col">Nachname</th>
               <th scope="col">E-Mail</th>
               <th scope="col">Status</th>
               <th scope="col" class="text-end">Aktion</th>
            </tr>
         </thead>
         <tbody>
            @foreach(ReaderDto reader in _readers) {
               <tr>
                  <td>@Display(reader.Firstname)</td>
                  <td>@Display(reader.Lastname)</td>
                  <td>@Display(reader.Email)</td>
                  <td>
                     @if(reader.IsActive) {
                        <span class="badge text-bg-success">Aktiv</span>
                     }
                     else {
                        <span class="badge text-bg-secondary">Inaktiv</span>
                     }
                  </td>
                  <td class="text-end">
                     <a class="btn btn-sm btn-outline-primary"
                        href="@ReaderDetailsUrl(reader.Id)">
                        Details
                     </a>
                  </td>
               </tr>
            }
         </tbody>
      </table>
   </div>
}

@code {

   private IReadOnlyList<ReaderDto> _readers = [];

   private CurrentUserInfo? _currentUser;

   private bool _includeInactive;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();
      Error = null;

      Result<IEnumerable<ReaderDto>> result = await ReaderClient.GetAllAsync(
         includeInactive: _includeInactive
      );

      if(result.IsSuccess && result.Value is not null)
         _readers = result.Value.ToList();
      else
         Error = result.Error;

      StopLoading();
   }

   private static string ReaderDetailsUrl(
      Guid readerId
   ) => $"/readers/{readerId}";

   private static string Display(
      string? value
   ) => string.IsNullOrWhiteSpace(value)
      ? "Nicht verfügbar"
      : value;
}

@* Didaktik:
   /readers is the employee-oriented overview for Reader resources.
   It links to /readers/{id}, where employees can inspect the selected Reader
   and deactivate the Reader if necessary.

   Reader self-service remains separate and uses /readers/me/... routes.
*@
