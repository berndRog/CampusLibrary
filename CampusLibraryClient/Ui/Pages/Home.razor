@page "/"
@rendermode InteractiveServer

@inject ICurrentUserProvider CurrentUserProvider

<PageTitle>CampusLibrary</PageTitle>

<h1>Willkommen</h1>

@if(_currentUser is null) {
   <p>Aktuelle Perspektive wird geladen...</p>
}
else {
   <section class="card">
      <h2>Aktuelle Perspektive</h2>

      <p>
         <strong>@_currentUser.DisplayName</strong>
         (@DisplayAccountType(_currentUser.AccountType))
      </p>

      <p>
         Bitte wählen Sie einen Bereich über die Menüleiste.
      </p>
   </section>
}

@code {

   private CurrentUserInfo? _currentUser;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
   }

   private static string DisplayAccountType(
      string? accountType
   ) => accountType?.ToLowerInvariant() switch {
      "reader" => "Leser/in",
      "employee" => "Mitarbeiter/in",
      _ => accountType ?? "unbekannt"
   };
}
