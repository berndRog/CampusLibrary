@rendermode InteractiveServer

@inject ICurrentUserProvider CurrentUserProvider

<PageTitle>CampusLibrary</PageTitle>

<h2 class="h3 mb-4">Willkommen</h2>

@if(_currentUser is null) {
   <p class="text-muted">Aktuelle Meldungen werden geladen...</p>
}
else {
   @* <section class="mb-4"> *@
   @*    <h2 class="h5 mb-3">Aktuelle Perspektive</h2> *@
   @* *@
   @*    <p class="mb-1"> *@
   @*       <strong>@_currentUser.DisplayName</strong> *@
   @*       <span class="text-muted">(@DisplayAccountType(_currentUser.AccountType))</span> *@
   @*    </p> *@
   @* *@
   @*    <p class="text-muted mb-0"> *@
   @*       Bitte wählen Sie einen Bereich über die Menüleiste. *@
   @*    </p> *@
   @* </section> *@

   <section>
      <h2 class="h5 mb-3">Aktuelle Meldungen</h2>

      <p class="mb-3">
         <strong>03.07.2026 10:30 Uhr:</strong>
         Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae
         libero at ipsum facilisis cursus. Donec non lorem sed neque tincidunt
         faucibus.
      </p>

      <p class="mb-0">
         <strong>02.07.2026 16:15 Uhr:</strong>
         Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent
         pretium, sapien non fermentum volutpat, arcu neque dignissim justo,
         vitae consequat sem lorem sed augue.
      </p>
   </section>
}

@code {

   private CurrentUserInfo? _currentUser;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
   }

   private static string DisplayAccountType(
      string? accountType
   ) => accountType?.ToLowerInvariant() switch {
      "reader" => "Leser/in",
      "employee" => "Mitarbeiter/in",
      _ => accountType ?? "unbekannt"
   };
}
