@page "/my/loans"
@rendermode InteractiveServer
@inherits BasePage

@inject ILoanClient LoanClient
@inject ICurrentUserProvider CurrentUserProvider

<PageTitle>My loans</PageTitle>

<h1>My loans</h1>

<p>
   Reader view. In Part 5 the current reader can be simulated with DevIdentity.
   In Part 6 the same page can use the logged-in reader from claims.
</p>

<button @onclick="LoadAsync">Reload</button>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p>Loading loans...</p>
}
else if(!_currentUser.IsReader) {
   <p>This page is intended for readers.</p>
}
else if(_loans.Count == 0) {
   <p>No active loans found for this reader.</p>
}
else {
   <table>
      <thead>
         <tr>
            <th>Title</th>
            <th>Inventory</th>
            <th>Loan date</th>
            <th>Due date</th>
            <th>Status</th>
            <th>Overdue</th>
         </tr>
      </thead>
      <tbody>
         @foreach(LoanListItemDto loan in _loans) {
            <tr>
               <td>@loan.Title</td>
               <td>@loan.InventoryNumber</td>
               <td>@loan.LoanDate.ToString("yyyy-MM-dd")</td>
               <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
               <td>@loan.Status</td>
               <td>@(loan.IsOverdue ? "Yes" : "No")</td>
            </tr>
         }
      </tbody>
   </table>
}

@code {

   private IReadOnlyList<LoanListItemDto> _loans = [];

   private CurrentUserInfo? _currentUser;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();

      if(_currentUser?.ReaderId is null) {
         _loans = [];
         StopLoading();
         return;
      }

      Result<IEnumerable<LoanListItemDto>> result =
         await LoanClient.GetBorrowedAsync();

      if(result.IsSuccess && result.Value is not null) {
         _loans = result.Value
            .Where(loan => loan.ReaderId == _currentUser.ReaderId.Value)
            .ToList();
      }
      else {
         Error = result.Error;
      }

      StopLoading();
   }
}
