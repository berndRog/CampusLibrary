@page "/my/loans"
@rendermode InteractiveServer
@inherits BasePage

@inject ILoanClient LoanClient
@inject ICurrentUserProvider CurrentUserProvider

<PageTitle>Ausleihen</PageTitle>
<h1 class="h3 mb-3">Ausleihen</h1>
<p class="text-muted">Leseransicht mit den Ausleihen des konfigurierten Readers.</p>
<button class="btn btn-outline-secondary mb-3" @onclick="LoadAsync">Neu laden</button>
<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p class="text-muted">Ausleihen werden geladen...</p>
}
else if(!_currentUser.IsReader) {
   <p>Diese Seite ist für Leserinnen und Leser vorgesehen.</p>
}
else if(Error is not null) { }
else if(_loans.Count == 0) {
   <p>Für diesen Reader wurden keine aktiven Ausleihen gefunden.</p>
}
else {
   <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
         <thead class="table-light"><tr>
            <th>Titel</th><th>Inventarnummer</th><th>Ausleihdatum</th>
            <th>Rückgabedatum</th><th>Überfällig</th><th>Aktion</th>
         </tr></thead>
         <tbody>
         @foreach(LoanDto loan in _loans) {
            <tr>
               <td>@loan.Title</td><td>@loan.BookItemId</td>
               <td>@loan.LoanDate.ToString("yyyy-MM-dd")</td><td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
               <td>@(loan.IsOverdue ? "Ja" : "Nein")</td>
               <td><a class="btn btn-outline-primary btn-sm" href="@($"/loans/{loan.Id}")">Details</a></td>
            </tr>
         }
         </tbody>
      </table>
   </div>
}

@code {
   private IReadOnlyList<LoanDto> _loans = [];
   private CurrentUserInfo? _currentUser;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();
      Error = null;
      Result<IEnumerable<LoanDto>> result = await LoanClient.GetMyBorrowedAsync();
      if(result.IsSuccess && result.Value is not null)
         _loans = result.Value.ToList();
      else {
         Error = result.Error;
         _loans = [];
      }
      StopLoading();
   }
}

@* Der Client sendet keine ReaderId. GET /loans/me löst den fachlichen Reader
   in der API über das konfigurierte DevIdentity-Subject auf. *@
