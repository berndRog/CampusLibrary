@page "/loans"
@rendermode InteractiveServer
@inherits BasePage
@* Part 8: protect this page with [Authorize(Policy = CampusLibraryPolicies.CanManageLoans)]. *@

@inject ILoanClient LoanClient
@inject ICurrentUserProvider CurrentUserProvider

<PageTitle>Ausleihen</PageTitle>

<h1 class="h3 mb-3">Ausleihen</h1>

<p class="text-muted">
   Mitarbeiteransicht. Diese Seite zeigt die Perspektive der Bibliothekstheke
   und listet alle aktuell ausgeliehenen Medien auf.
</p>

<button class="btn btn-outline-secondary mb-3" @onclick="LoadAsync">Neu laden</button>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p class="text-muted">Ausleihen werden geladen...</p>
}
else if(!_currentUser.IsEmployee) {
   <p>Diese Seite ist für Mitarbeitende vorgesehen.</p>
}
else if(_loans.Count == 0) {
   <p>Keine aktiven Ausleihen gefunden.</p>
}
else {
   <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
         <thead class="table-light">
            <tr>
               <th scope="col">Reader</th>
               <th scope="col">Titel</th>
               <th scope="col">Inventarnummer</th>
               <th scope="col">Ausleihdatum</th>
               <th scope="col">Rückgabedatum</th>
               <th scope="col">Status</th>
               <th scope="col">Überfällig</th>
               <th scope="col">Aktion</th>
            </tr>
         </thead>
         <tbody>
            @foreach(LoanListItemDto loan in _loans) {
               <tr>
                  <td>@loan.Firstname @loan.Lastname</td>
                  <td>@loan.Title</td>
                  <td>@loan.InventoryNumber</td>
                  <td>@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                  <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                  <td>@loan.Status</td>
                  <td>@(loan.IsOverdue ? "Ja" : "Nein")</td>
                  <td>
                     <a class="btn btn-outline-primary btn-sm" href="@($"/loans/{loan.Id}")">
                        Details
                     </a>
                  </td>
               </tr>
            }
         </tbody>
      </table>
   </div>
}

@code {

   private IReadOnlyList<LoanListItemDto> _loans = [];

   private CurrentUserInfo? _currentUser;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();
      Error = null;

      Result<IEnumerable<LoanListItemDto>> result = await LoanClient.GetBorrowedAsync();

      if(result.IsSuccess && result.Value is not null)
         _loans = result.Value.ToList();
      else
         Error = result.Error;

      StopLoading();
   }
}
