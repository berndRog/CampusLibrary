@page "/catalog/books/{BookId:guid}/borrow"
@attribute [Authorize(Roles = CampusLibraryRoles.Reader)]
@rendermode InteractiveServer
@inherits BasePage

@inject IBookClient BookClient
@inject ILoanClient LoanClient
@inject IReaderClient ReaderClient
@inject NavigationManager Navigation

<PageTitle>Buch ausleihen</PageTitle>

<h1 class="h3 mb-3">Buch ausleihen</h1>

<ErrorAlert Error="Error" />

@if(IsLoading) {
   <p class="text-muted">Ausleihdaten werden geladen...</p>
}
else if(Error is not null) {
   @* ErrorAlert above displays the API error. *@
}
else if(_readerProfile?.IsProfileCompleted != true) {
   <div class="alert alert-warning" role="alert">
      Bitte vervollständigen Sie zuerst Ihr Profil, bevor Sie Bücher ausleihen.
   </div>
   <a class="btn btn-primary" href="/readers/profile">Profil vervollständigen</a>
}
else if(_book is null) {
   <p>Buch nicht gefunden.</p>
   <button class="btn btn-outline-secondary" @onclick="Cancel">Zurück zum Katalog</button>
}
else if(_alreadyBorrowedByReader) {
   <div class="alert alert-info" role="alert">
      Sie haben bereits ein Exemplar dieses Buchs ausgeliehen.
   </div>

   <button class="btn btn-outline-secondary" @onclick="Cancel">
      Zurück zum Katalog
   </button>
}
else {
   <div class="card shadow-sm mb-3">
      <div class="card-body">
         <h2 class="h5 card-title mb-3">Buch</h2>

         <dl class="row mb-0">
            <dt class="col-sm-3">Titel</dt>
            <dd class="col-sm-9">@_book.Title</dd>

            <dt class="col-sm-3">Untertitel</dt>
            <dd class="col-sm-9">@_book.Subtitle</dd>

            <dt class="col-sm-3">Autorinnen/Autoren</dt>
            <dd class="col-sm-9">@_book.AuthorsText</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@_book.Isbn</dd>

            <dt class="col-sm-3">Ausgeliehen / Gesamt</dt>
            <dd class="col-sm-9">@_borrowedItems / @_totalItems</dd>

            <dt class="col-sm-3">Verfügbar</dt>
            <dd class="col-sm-9">@_availableItems.Count</dd>
         </dl>
      </div>
   </div>

   <div class="card shadow-sm mb-3">
      <div class="card-body">
         <h2 class="h5 card-title mb-3">Leser/in</h2>

         <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@_readerProfile.Firstname @_readerProfile.Lastname</dd>

            <dt class="col-sm-3">E-Mail</dt>
            <dd class="col-sm-9">@_readerProfile.Email</dd>
         </dl>
      </div>
   </div>

   <div class="card shadow-sm mb-3">
      <div class="card-body">
         <h2 class="h5 card-title mb-3">Geplante Ausleihe</h2>

         <dl class="row mb-0">
            <dt class="col-sm-3">Ausleihdatum</dt>
            <dd class="col-sm-9">@DateTime.Today.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Rückgabedatum</dt>
            <dd class="col-sm-9">@DateTime.Today.AddDays(28).ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Exemplar</dt>
            <dd class="col-sm-9">
               @if(_availableItems.Count == 0) {
                  <span class="text-muted">Kein ausleihbares Exemplar gefunden.</span>
               }
               else {
                  <select class="form-select" @bind="_selectedBookItemId">
                     @foreach(BookItemDto item in _availableItems) {
                        <option value="@item.Id">
                           @item.Id (@item.Id)
                        </option>
                     }
                  </select>
               }
            </dd>
         </dl>
      </div>
   </div>

   <div class="d-flex flex-wrap gap-2">
      <button class="btn btn-outline-secondary" @onclick="Cancel">Abbrechen</button>
      <button class="btn btn-primary"
              @onclick="ConfirmBorrowAsync"
              disabled="@(_availableItems.Count == 0 || IsLoading)">
         Ausleihe abschließen
      </button>
   </div>
}

@code {

   [Parameter]
   public Guid BookId { get; set; }

   private const int AvailableBookItemStatus = 1;

   private BookDto? _book;

   private ReaderDto? _readerProfile;

   private IReadOnlyList<BookItemDto> _availableItems = [];

   private int _totalItems;

   private int _borrowedItems;

   private Guid _selectedBookItemId;

   private bool _alreadyBorrowedByReader;

   protected override async Task OnInitializedAsync() {
      StartLoading();
      Error = null;

      await LoadReaderProfileAsync();

      if(Error is not null) {
         StopLoading();
         return;
      }

      Result<BookDto> result = await BookClient.GetByIdAsync(
         id: BookId
      );

      if(result.IsSuccess && result.Value is not null) {
         _book = result.Value;
         await RefreshAvailableBookItemsAsync();
      }
      else {
         Error = result.Error;
      }

      StopLoading();
   }

   private async Task LoadReaderProfileAsync() {
      // Provisioning is performed centrally by /entry after OIDC login.
      // This page only loads the already existing fachlicher Reader.
      Result<ReaderDto> readerResult = await ReaderClient.GetMeAsync();
      if(readerResult.IsSuccess && readerResult.Value is not null)
         _readerProfile = readerResult.Value;
      else
         Error = readerResult.Error;
   }

   private async Task RefreshAvailableBookItemsAsync() {
      if(_book is null)
         return;

      Result<IEnumerable<LoanDto>> loanResult = await LoanClient.GetBorrowedAsync();

      if(loanResult.IsFailure || loanResult.Value is null) {
         Error = loanResult.Error;
         _availableItems = [];
         _borrowedItems = 0;
         return;
      }

      IReadOnlyList<LoanDto> borrowedLoans =
         loanResult.Value.ToList();

      HashSet<Guid> borrowedBookItemIds = borrowedLoans
         .Select(loan => loan.BookItemId)
         .ToHashSet();

      IReadOnlyList<BookItemDto> bookItems = _book.BookItems ?? [];

      if(_readerProfile is not null) {
         Result<IEnumerable<LoanDto>> myLoansResult =
            await LoanClient.GetMyBorrowedAsync();

         if(myLoansResult.IsFailure || myLoansResult.Value is null) {
            Error = myLoansResult.Error;
            _availableItems = [];
            return;
         }

         HashSet<Guid> borrowedBookItemIdsByReader = myLoansResult.Value
            .Select(loan => loan.BookItemId)
            .ToHashSet();

         _alreadyBorrowedByReader = bookItems.Any(item =>
            borrowedBookItemIdsByReader.Contains(item.Id)
         );
      }

      _totalItems = bookItems.Count;

      if(_totalItems == 0)
         _totalItems = _book.TotalItems;

      _availableItems = bookItems
         .Where(item =>
            item.Status == AvailableBookItemStatus &&
            !borrowedBookItemIds.Contains(item.Id)
         )
         .ToList();

      _borrowedItems = Math.Max(
         val1: 0,
         val2: _totalItems - _availableItems.Count
      );

      if(_availableItems.Count > 0)
         _selectedBookItemId = _availableItems[0].Id;
   }

   private async Task ConfirmBorrowAsync() {
      if(_alreadyBorrowedByReader) {
         Error = new ApiError(
            Status: 409,
            Title: "Book already borrowed",
            Detail: "You already borrowed another book item of this book."
         );

         return;
      }

      if(_readerProfile?.IsProfileCompleted != true) {
         Navigation.NavigateTo("/readers/profile");
         return;
      }

      if(_selectedBookItemId == Guid.Empty) {
         Error = new ApiError(
            Status: 400,
            Title: "Missing book item",
            Detail: "Select an available book item before completing the loan."
         );

         return;
      }

      StartLoading();
      Error = null;

      LoanBorrowMeDto dto = new(
         BookItemId: _selectedBookItemId
      );

      Result<LoanDto> result = await LoanClient.BorrowMyAsync(
         dto: dto
      );

      if(result.IsFailure) {
         Error = result.Error;
         StopLoading();
         return;
      }

      StopLoading();
      Navigation.NavigateTo("/loans/me");
   }

   private void Cancel() {
      Navigation.NavigateTo("/catalog/books");
   }
}
