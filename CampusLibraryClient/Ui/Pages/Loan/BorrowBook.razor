@page "/catalog/books/{BookId:guid}/borrow"
@rendermode InteractiveServer
@inherits BasePage

@inject IBookClient BookClient
@inject ILoanClient LoanClient
@inject ICurrentUserProvider CurrentUserProvider
@inject NavigationManager Navigation

<PageTitle>Buch ausleihen</PageTitle>

<h1>Buch ausleihen</h1>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p>Ausleihdaten werden geladen...</p>
}
else if(!_currentUser.IsReader) {
   <p>
      Das Ausleihen von Büchern ist für die Leserperspektive vorgesehen.
      In Teil 5 wird diese Perspektive über DevIdentity simuliert.
   </p>
   <button @onclick="Cancel">Zurück zum Katalog</button>
}
else if(_book is null) {
   <p>Buch nicht gefunden.</p>
   <button @onclick="Cancel">Zurück zum Katalog</button>
}
else {
   <section class="card">
      <h2>Buch</h2>
      <dl>
         <dt>Titel</dt>
         <dd>@_book.Title</dd>

         <dt>Untertitel</dt>
         <dd>@_book.Subtitle</dd>

         <dt>Autorinnen/Autoren</dt>
         <dd>@_book.AuthorsText</dd>

         <dt>ISBN</dt>
         <dd>@_book.Isbn</dd>

         <dt>Ausgeliehen / Gesamt</dt>
         <dd>@_borrowedItems / @_totalItems</dd>

         <dt>Verfügbar</dt>
         <dd>@_availableItems.Count</dd>
      </dl>
   </section>

   <section class="card">
      <h2>Leser/in</h2>
      <dl>
         <dt>Name</dt>
         <dd>@_currentUser.DisplayName</dd>

         <dt>E-Mail</dt>
         <dd>@_currentUser.Email</dd>

         <dt>Reader Id</dt>
         <dd>@_currentUser.ReaderId</dd>
      </dl>
   </section>

   <section class="card">
      <h2>Geplante Ausleihe</h2>
      <dl>
         <dt>Ausleihdatum</dt>
         <dd>@DateTime.Today.ToString("yyyy-MM-dd")</dd>

         <dt>Rückgabedatum</dt>
         <dd>@DateTime.Today.AddDays(28).ToString("yyyy-MM-dd")</dd>

         <dt>Exemplar</dt>
         <dd>
            @if(_availableItems.Count == 0) {
               <span>Kein ausleihbares Exemplar gefunden.</span>
            }
            else {
               <select @bind="_selectedBookItemId">
                  @foreach(BookItemDto item in _availableItems) {
                     <option value="@item.Id">
                        @item.InventoryNumber (@item.Id)
                     </option>
                  }
               </select>
            }
         </dd>
      </dl>
   </section>

   <div class="toolbar">
      <button @onclick="Cancel">Abbrechen</button>
      <button
         @onclick="ConfirmBorrowAsync"
         disabled="@(_availableItems.Count == 0 || IsLoading)">
         Ausleihe abschließen
      </button>
   </div>
}

@code {

   [Parameter]
   public Guid BookId { get; set; }

   private const int AvailableBookItemStatus = 1;

   private BookDetailDto? _book;

   private IReadOnlyList<BookItemDto> _availableItems = [];

   private int _totalItems;

   private int _borrowedItems;

   private Guid _selectedBookItemId;

   private CurrentUserInfo? _currentUser;

   protected override async Task OnInitializedAsync() {
      StartLoading();
      Error = null;

      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();

      Result<BookDetailDto> result = await BookClient.GetByIdAsync(
         id: BookId
      );

      if(result.IsSuccess && result.Value is not null) {
         _book = result.Value;
         await RefreshAvailableBookItemsAsync();
      }
      else {
         Error = result.Error;
      }

      StopLoading();
   }

   private async Task RefreshAvailableBookItemsAsync() {
      if(_book is null)
         return;

      Result<IEnumerable<LoanListItemDto>> loanResult = await LoanClient.GetBorrowedAsync();

      HashSet<Guid> borrowedBookItemIds = loanResult.IsSuccess && loanResult.Value is not null
         ? loanResult.Value.Select(loan => loan.BookItemId).ToHashSet()
         : [];

      IReadOnlyList<BookItemDto> bookItems = _book.BookItems ?? [];

      _totalItems = bookItems.Count;

      if(_totalItems == 0)
         _totalItems = _book.TotalItems;

      _availableItems = bookItems
         .Where(item =>
            item.Status == AvailableBookItemStatus &&
            !borrowedBookItemIds.Contains(item.Id)
         )
         .ToList();

      _borrowedItems = Math.Max(
         val1: 0,
         val2: _totalItems - _availableItems.Count
      );

      if(_availableItems.Count > 0)
         _selectedBookItemId = _availableItems[0].Id;
   }

   private async Task ConfirmBorrowAsync() {
      if(_currentUser?.ReaderId is null) {
         Error = new ApiError(
            Status: 400,
            Title: "Missing reader",
            Detail: "The current reader has no ReaderId. Check DevIdentity or the login claims."
         );

         return;
      }

      if(_selectedBookItemId == Guid.Empty) {
         Error = new ApiError(
            Status: 400,
            Title: "Missing book item",
            Detail: "Select an available book item before completing the loan."
         );

         return;
      }

      StartLoading();
      Error = null;

      LoanCreateDto dto = new(
         ReaderId: _currentUser.ReaderId.Value,
         BookItemId: _selectedBookItemId
      );

      Result<LoanDto> result = await LoanClient.BorrowAsync(
         dto: dto
      );

      if(result.IsFailure) {
         Error = result.Error;
         StopLoading();
         return;
      }

      StopLoading();
      Navigation.NavigateTo("/my/loans");
   }

   private void Cancel() {
      Navigation.NavigateTo("/catalog/books");
   }
}
