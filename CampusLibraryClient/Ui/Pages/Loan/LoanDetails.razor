@page "/loans/{LoanId:guid}"
@rendermode InteractiveServer
@inherits BasePage

@inject ILoanClient LoanClient
@inject ICurrentUserProvider CurrentUserProvider
@inject NavigationManager Navigation

<PageTitle>Ausleihe Details</PageTitle>

<h1 class="h3 mb-3">Ausleihe Details</h1>

<ErrorAlert Error="Error"/>

@if (IsLoading || _currentUser is null) {
   <p class="text-muted">Ausleihe wird geladen...</p>
}
else if (_loan is null) {
   <p>Keine Ausleihe gefunden.</p>
}
else if (!CanViewLoan()) {
   <p>Diese Ausleihe kann mit der aktuellen Demo-Identität nicht angezeigt werden.</p>
}
else {
   <h2 class="h5">Buch</h2>

   <dl class="row mb-0">
      <dt class="col-sm-3 mb-0">Titel</dt>
      <dd class="col-sm-9 mb-0">@Display(_loan.Title)</dd>

      <dt class="col-sm-3 mb-0">Untertitel</dt>
      <dd class="col-sm-9 mb-0">@Display(_loan.Subtitle)</dd>

      <dt class="col-sm-3 mb-0">Autoren</dt>
      <dd class="col-sm-9 mb-0">@Display(_loan.AuthorsText)</dd>

      <dt class="col-sm-3 mb-0">ISBN</dt>
      <dd class="col-sm-9 mb-0">@Display(_loan.Isbn)</dd>

   </dl>

   <dl class="row mb-0">
      <dt class="col-sm-3 mb-1">Inventarnummer</dt>
      <dd class="col-sm-9 mb-1">@Display(_loan.BookItemId.ToString())</dd>
   </dl>

   <h2 class="h5 mt-2">Leser</h2>

   <dl class="row mb-0">
      <dt class="col-sm-3 mb-0">Name</dt>
      <dd class="col-sm-9 mb-0">@Display(ReaderName)</dd>
     
      <dt class="col-sm-3 mb-0">Email</dt> 
      <dd class="col-sm-9 mb-0">@_loan.Email</dd>
   </dl>

   <h2 class="h5 mt-2">Ausleihe</h2>
   
   <dl class="row mb-0">

      <dt class="col-sm-3 mb-0">Ausleihdatum</dt>
      <dd class="col-sm-9 mb-0">@FormatDate(_loan.LoanDate)</dd>

      <dt class="col-sm-3 mb-0">Fällig am</dt>
      <dd class="col-sm-9 mb-0">@FormatDate(_loan.DueDate)</dd>
      
      <dt class="col-sm-3 mb-0">Status</dt>
      <dd class="col-sm-9 mb-0">@(_loan.Status == 1 ? "ausgeliehen" : "zurückgegeben")</dd>
      
      <dt class="col-sm-3 mb-0">Verlängerungen</dt>
      <dd class="col-sm-9 mb-0">@_loan.RenewalCount</dd>

      <dt class="col-sm-3 mb-0">Überfällig</dt>
      <dd class="col-sm-9 mb-0">@YesNo(_loan.IsOverdue)</dd>

      @* <dt class="col-sm-3 mb-1">Zurückgegeben am</dt> *@
      @* <dd class="col-sm-9 mb-1">@(_loan.ReturnedAt is null ? "Nein" : FormatDate(_loan.ReturnedAt.Value))</dd> *@

      <dt class="col-sm-3 mb-1">Verlängerbar</dt>
      <dd class="col-sm-9 mb-1">@YesNo(_loan.CanRenew)</dd>
   </dl>

   <div class="mt-3 d-flex flex-wrap gap-2">
      <button class="btn btn-outline-secondary" @onclick="BackToOverview">
         Zurück zur Übersicht
      </button>

      @if (_loan.ReturnedAt is null) {
         <button class="btn btn-outline-primary" @onclick="RenewAsync" disabled="@(!_loan.CanRenew || IsLoading)">
            Verlängern
         </button>

         <button class="btn btn-primary" @onclick="ReturnAtDeskAsync" disabled="@IsLoading">
            Zurückgeben
         </button>
      }
   </div>
}

@code {

   [Parameter] public Guid LoanId { get; set; }

   private LoanDetailDto? _loan;

   private CurrentUserInfo? _currentUser;

   private string ReaderName {
      get {
         if (_loan is null)
            return string.Empty;

         return $"{_loan.Firstname} {_loan.Lastname}".Trim();
      }
   }

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();
      Error = null;

      var result = await LoanClient.GetByIdAsync(id: LoanId);

      if (result.IsSuccess && result.Value is not null)
         _loan = result.Value;
      else
         Error = result.Error;

      StopLoading();
   }

   private bool CanViewLoan() {
      if (_currentUser is null || _loan is null)
         return false;

      if (_currentUser.IsEmployee)
         return true;

      if (_currentUser.IsReader && _currentUser.ReaderId == _loan.ReaderId)
         return true;

      return false;
   }

   private async Task RenewAsync() {
      if (_loan is null)
         return;

      StartLoading();
      Error = null;

      var result = await LoanClient.RenewAsync(_loan.Id);
      if (result.IsFailure) {
         Error = result.Error;
         StopLoading();
         return;
      }

      await LoadAsync();
   }

   private async Task ReturnAtDeskAsync() {
      if (_loan is null)
         return;

      StartLoading();
      Error = null;

      var result = await LoanClient.ReturnAtDeskAsync(_loan.Id);
      if (result.IsFailure) {
         Error = result.Error;
         StopLoading();
         return;
      }

      await LoadAsync();
   }

   private void BackToOverview() {
      if (_currentUser?.IsReader == true)
         Navigation.NavigateTo("/my/loans");
      else
         Navigation.NavigateTo("/loans");
   }

   private static string Display(
      string? value
   ) => string.IsNullOrWhiteSpace(value)
      ? "Nicht verfügbar"
      : value;

   private static string FormatDate(
      DateTime value
   ) => value.ToString("yyyy-MM-dd");

   private static string YesNo(
      bool value
   ) => value ? "Ja" : "Nein";

}