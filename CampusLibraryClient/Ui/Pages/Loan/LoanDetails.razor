@page "/loans/{LoanId:guid}"
@rendermode InteractiveServer
@inherits BasePage

@inject ILoanClient LoanClient
@inject ICurrentUserProvider CurrentUserProvider
@inject NavigationManager Navigation

<PageTitle>Ausleihe Details</PageTitle>

<h1 class="h3 mb-3">Ausleihe Details</h1>

<p class="text-muted">
   Diese Seite zeigt die Detaildaten einer Ausleihe.
</p>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p class="text-muted">Ausleihe wird geladen...</p>
}
else if(_loan is null) {
   <p>Keine Ausleihe gefunden.</p>
}
else if(!CanViewLoan()) {
   <p>Diese Ausleihe kann mit der aktuellen Demo-Identität nicht angezeigt werden.</p>
}
else {
   <div class="card shadow-sm mb-3">
      <div class="card-body">
         <h2 class="h5 card-title mb-3">Buchdetails</h2>

         <dl class="row mb-0">
            <dt class="col-sm-3">Titel</dt>
            <dd class="col-sm-9">@Display(_loan.Title)</dd>

            <dt class="col-sm-3">Untertitel</dt>
            <dd class="col-sm-9">@Display(_loan.Subtitle)</dd>

            <dt class="col-sm-3">Autoren</dt>
            <dd class="col-sm-9">@Display(_loan.AuthorsText)</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@Display(_loan.Isbn)</dd>

            <dt class="col-sm-3">Buch Id</dt>
            <dd class="col-sm-9"><code>@_loan.BookId</code></dd>

            <dt class="col-sm-3">Aktiv</dt>
            <dd class="col-sm-9">@YesNo(_loan.BookIsActive)</dd>
         </dl>
      </div>
   </div>

   <div class="card shadow-sm mb-3">
      <div class="card-body">
         <h2 class="h5 card-title mb-3">Exemplardetails</h2>

         <dl class="row mb-0">
            <dt class="col-sm-3">Inventarnummer</dt>
            <dd class="col-sm-9">@Display(_loan.InventoryNumber)</dd>

            <dt class="col-sm-3">Exemplar Id</dt>
            <dd class="col-sm-9"><code>@_loan.BookItemId</code></dd>

            <dt class="col-sm-3">Für Ausleihe verfügbar</dt>
            <dd class="col-sm-9">@YesNo(_loan.IsAvailableForLoan)</dd>
         </dl>
      </div>
   </div>

   <div class="card shadow-sm mb-3">
      <div class="card-body">
         <h2 class="h5 card-title mb-3">Leserdetails</h2>

         <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Display(ReaderName)</dd>

            <dt class="col-sm-3">Reader Id</dt>
            <dd class="col-sm-9"><code>@_loan.ReaderId</code></dd>
         </dl>
      </div>
   </div>

   <div class="card shadow-sm mb-3">
      <div class="card-body">
         <h2 class="h5 card-title mb-3">Ausleihdetails</h2>

         <dl class="row mb-0">
            <dt class="col-sm-3">Ausleihe Id</dt>
            <dd class="col-sm-9"><code>@_loan.Id</code></dd>

            <dt class="col-sm-3">Ausleihdatum</dt>
            <dd class="col-sm-9">@FormatDate(_loan.LoanDate)</dd>

            <dt class="col-sm-3">Fällig am</dt>
            <dd class="col-sm-9">@FormatDate(_loan.DueDate)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@_loan.Status</dd>

            <dt class="col-sm-3">Verlängerungen</dt>
            <dd class="col-sm-9">@_loan.RenewalCount</dd>

            <dt class="col-sm-3">Überfällig</dt>
            <dd class="col-sm-9">@YesNo(_loan.IsOverdue)</dd>

            <dt class="col-sm-3">Zurückgegeben am</dt>
            <dd class="col-sm-9">@(_loan.ReturnedAt is null ? "Nein" : FormatDate(_loan.ReturnedAt.Value))</dd>

            <dt class="col-sm-3">Verlängerbar</dt>
            <dd class="col-sm-9">@YesNo(_loan.CanRenew)</dd>
         </dl>
      </div>
   </div>

   <div class="d-flex flex-wrap gap-2">
      <button class="btn btn-outline-secondary" @onclick="BackToOverview">
         Zurück zur Übersicht
      </button>

      @if(_loan.ReturnedAt is null) {
         <button class="btn btn-outline-primary" @onclick="RenewAsync" disabled="@(!_loan.CanRenew || IsLoading)">
            Verlängern
         </button>

         <button class="btn btn-primary" @onclick="ReturnAtDeskAsync" disabled="@IsLoading">
            Zurückgeben
         </button>
      }
   </div>
}

@code {

   [Parameter]
   public Guid LoanId { get; set; }

   private LoanDetailDto? _loan;

   private CurrentUserInfo? _currentUser;

   private string ReaderName {
      get {
         if(_loan is null)
            return string.Empty;

         return $"{_loan.Firstname} {_loan.Lastname}".Trim();
      }
   }

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();
      Error = null;

      Result<LoanDetailDto> result = await LoanClient.GetByIdAsync(
         id: LoanId
      );

      if(result.IsSuccess && result.Value is not null)
         _loan = result.Value;
      else
         Error = result.Error;

      StopLoading();
   }

   private bool CanViewLoan() {
      if(_currentUser is null || _loan is null)
         return false;

      if(_currentUser.IsEmployee)
         return true;

      if(_currentUser.IsReader && _currentUser.ReaderId == _loan.ReaderId)
         return true;

      return false;
   }

   private async Task RenewAsync() {
      if(_loan is null)
         return;

      StartLoading();
      Error = null;

      Result<LoanDto> result = await LoanClient.RenewAsync(
         id: _loan.Id
      );

      if(result.IsFailure) {
         Error = result.Error;
         StopLoading();
         return;
      }

      await LoadAsync();
   }

   private async Task ReturnAtDeskAsync() {
      if(_loan is null)
         return;

      StartLoading();
      Error = null;

      Result<LoanDto> result = await LoanClient.ReturnAtDeskAsync(
         id: _loan.Id
      );

      if(result.IsFailure) {
         Error = result.Error;
         StopLoading();
         return;
      }

      await LoadAsync();
   }

   private void BackToOverview() {
      if(_currentUser?.IsReader == true)
         Navigation.NavigateTo("/my/loans");
      else
         Navigation.NavigateTo("/loans");
   }

   private static string Display(
      string? value
   ) => string.IsNullOrWhiteSpace(value)
      ? "Nicht verfügbar"
      : value;

   private static string FormatDate(
      DateTime value
   ) => value.ToString("yyyy-MM-dd");

   private static string YesNo(
      bool value
   ) => value ? "Ja" : "Nein";
}
