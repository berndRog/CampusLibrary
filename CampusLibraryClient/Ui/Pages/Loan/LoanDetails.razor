@page "/loans/{LoanId:guid}"
@attribute [Authorize(Roles = CampusLibraryRoles.ReaderOrEmployee)]
@rendermode InteractiveServer
@inherits BasePage

@inject ILoanClient LoanClient
@inject ICurrentUserProvider CurrentUserProvider
@inject NavigationManager Navigation

<PageTitle>Ausleihe Details</PageTitle>

<h1 class="h3 mb-3">Details</h1>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p class="text-muted">Ausleihe wird geladen...</p>
}
else if(Error is not null) {
   @* ErrorAlert above displays the API error. *@
}
else if(_loan is null) {
   <p>Keine Ausleihe gefunden.</p>
}
else {
   <h2 class="h5">Buch</h2>

   <dl class="row mb-0">
      <dt class="col-sm-3 mb-0">Titel</dt>
      <dd class="col-sm-9 mb-0">@Display(_loan.Title)</dd>

      <dt class="col-sm-3 mb-0">Untertitel</dt>
      <dd class="col-sm-9 mb-0">@Display(_loan.Subtitle)</dd>

      <dt class="col-sm-3 mb-0">Autoren</dt>
      <dd class="col-sm-9 mb-0">@Display(_loan.AuthorsText)</dd>

      <dt class="col-sm-3 mb-0">ISBN</dt>
      <dd class="col-sm-9 mb-0">@Display(_loan.Isbn)</dd>
   </dl>

   <dl class="row mb-0">
      <dt class="col-sm-3 mb-1">Inventarnummer</dt>
      <dd class="col-sm-9 mb-1">@Display(_loan.BookItemId.ToString())</dd>
   </dl>

   <h2 class="h5 mt-2">Leser</h2>

   <dl class="row mb-0">
      <dt class="col-sm-3 mb-0">Name</dt>
      <dd class="col-sm-9 mb-0">@Display(ReaderName)</dd>

      <dt class="col-sm-3 mb-0">Email</dt>
      <dd class="col-sm-9 mb-0">@_loan.Email</dd>
   </dl>

   <h2 class="h5 mt-2">Ausleihe</h2>

   <dl class="row mb-0">
      <dt class="col-sm-3 mb-0">Ausleihdatum</dt>
      <dd class="col-sm-9 mb-0">@FormatDate(_loan.LoanDate)</dd>

      <dt class="col-sm-3 mb-0">Fällig am</dt>
      <dd class="col-sm-9 mb-0">@FormatDate(_loan.DueDate)</dd>

      <dt class="col-sm-3 mb-0">Verlängerungen</dt>
      <dd class="col-sm-9 mb-0">@_loan.RenewalCount</dd>

      <dt class="col-sm-3 mb-0">Überfällig</dt>
      <dd class="col-sm-9 mb-0">@YesNo(_loan.IsOverdue)</dd>

      <dt class="col-sm-3 mb-1">Verlängerbar</dt>
      <dd class="col-sm-9 mb-1">@YesNo(_loan.CanRenew)</dd>
   </dl>

   <div class="mt-3 d-flex flex-wrap gap-2">
      <button class="btn btn-outline-secondary" @onclick="BackToOverview">
         Zurück zur Übersicht
      </button>

      @if(_currentUser.IsReader) {
         <button class="btn btn-outline-primary"
                 @onclick="RenewAsync"
                 disabled="@(!_loan.CanRenew || IsLoading)">
            Verlängern
         </button>
      }

      @if(_currentUser.IsEmployee) {
         <button class="btn btn-primary"
                 @onclick="ReturnAtDeskAsync"
                 disabled="@IsLoading">
            Zurückgeben
         </button>
      }
   </div>
}

@code {

   [Parameter]
   public Guid LoanId { get; set; }

   private LoanDto? _loan;

   private CurrentUserInfo? _currentUser;

   private string ReaderName {
      get {
         if(_loan is null)
            return string.Empty;

         return $"{_loan.Firstname} {_loan.Lastname}".Trim();
      }
   }

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();
      Error = null;

      Result<LoanDto> result = _currentUser?.IsReader == true
         ? await LoanClient.GetMyByIdAsync(
            id: LoanId
         )
         : await LoanClient.GetByIdAsync(
            id: LoanId
         );

      if(result.IsSuccess && result.Value is not null)
         _loan = result.Value;
      else {
         Error = result.Error;
         _loan = null;
      }

      StopLoading();
   }

   private async Task RenewAsync() {
      if(_loan is null || _currentUser?.IsReader != true)
         return;

      StartLoading();
      Error = null;

      Result<LoanDto> result = await LoanClient.RenewMyAsync(
         id: _loan.Id
      );

      if(result.IsFailure) {
         Error = result.Error;
         StopLoading();
         return;
      }

      await LoadAsync();
   }

   private async Task ReturnAtDeskAsync() {
      if(_loan is null || _currentUser?.IsEmployee != true)
         return;

      StartLoading();
      Error = null;

      Result<bool> result = await LoanClient.ReturnAtDeskAsync(
         id: _loan.Id
      );

      if(result.IsFailure) {
         Error = result.Error;
         StopLoading();
         return;
      }

      BackToOverview();
   }

   private void BackToOverview() {
      Navigation.NavigateTo(
         _currentUser?.IsReader == true
            ? "/loans/me"
            : "/loans"
      );
   }

   private static string Display(
      string? value
   ) => string.IsNullOrWhiteSpace(value)
      ? "Nicht verfügbar"
      : value;

   private static string FormatDate(
      DateTime value
   ) => value.ToString("yyyy-MM-dd");

   private static string YesNo(
      bool value
   ) => value ? "Ja" : "Nein";
}

@* Didaktik:
   Die Detailseite führt keine Client-seitige Eigentumsprüfung mehr durch.

   Reader verwenden GET /loans/me/{id}. Die API bestimmt den fachlichen Reader
   aus dem Token-Subject und liefert nur eine eigene Ausleihe. Employees
   verwenden weiterhin den administrativen Endpunkt GET /loans/{id}.

   Client-seitige Prüfungen sind nur für die Darstellung von Aktionen gedacht:
   Reader können ihre eigene Ausleihe verlängern; die Rückgabe am Desk ist eine
   Employee-Aktion. Die eigentliche Autorisierung bleibt Aufgabe der API.
*@
