@page "/loans/me"
@attribute [Authorize(Roles = CampusLibraryRoles.Reader)]
@rendermode InteractiveServer
@inherits BasePage

@inject ILoanClient LoanClient

<PageTitle>Ausleihen</PageTitle>

<button class="btn btn-outline-secondary mb-3" @onclick="LoadAsync">Neu laden</button>

<ErrorAlert Error="Error" />

@if(IsLoading) {
   <p class="text-muted">Ausleihen werden geladen...</p>
}
else if(Error is not null) {
   @* ErrorAlert above displays the API error. *@
}
else if(_loans.Count == 0) {
   <p>Es wurden keine aktiven Ausleihen gefunden.</p>
}
else {
   <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
         <thead class="table-light">
            <tr>
               <th scope="col">Titel</th>
               <th scope="col">Ausleihdatum</th>
               <th scope="col">Rückgabedatum</th>
               <th scope="col">Überfällig</th>
               <th scope="col">Aktion</th>
               <th scope="col">Inventarnummer</th>
            </tr>
         </thead>
         <tbody>
            @foreach(LoanDto loan in _loans) {
               <tr>
                  <td>@loan.Title</td>
                  <td>@loan.LoanDate.ToString("yyyy-MM-dd")</td>
                  <td>@loan.DueDate.ToString("yyyy-MM-dd")</td>
                  <td>@(loan.IsOverdue ? "Ja" : "Nein")</td>
                  <td>
                     <a class="btn btn-outline-primary btn-sm" href="@($"/loans/{loan.Id}")">
                        Details
                     </a>
                  </td>
                  <td>@loan.BookItemId</td>
               </tr>
            }
         </tbody>
      </table>
   </div>
}

@code {

   private IReadOnlyList<LoanDto> _loans = [];

   protected override async Task OnInitializedAsync() {
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();
      Error = null;

      Result<IEnumerable<LoanDto>> result =
         await LoanClient.GetMyBorrowedAsync();

      if(result.IsSuccess && result.Value is not null)
         _loans = result.Value.ToList();
      else {
         Error = result.Error;
         _loans = [];
      }

      StopLoading();
   }
}

@* Didaktik:
   Diese Seite ist eine echte Self-Service-Seite.

   Der Client übermittelt keine ReaderId und filtert keine globale Loan-Liste.
   GET /loans/me bestimmt den fachlichen Reader serverseitig aus dem Token-
   Subject und liefert ausschließlich dessen aktuelle Ausleihen.

   Profilvollständigkeit wird hier nicht geprüft. Ein vorhandener Loan setzt
   voraus, dass die Ausleihe früher fachlich erfolgreich angelegt wurde.
*@
