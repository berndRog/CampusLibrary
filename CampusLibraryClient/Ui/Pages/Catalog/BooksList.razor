@page "/catalog/books"
@rendermode InteractiveServer
@inherits BasePage

@inject IBookClient BookClient
@inject ICurrentUserProvider CurrentUserProvider
@inject NavigationManager Navigation

<PageTitle>Books</PageTitle>

<h1>Books</h1>

<p>
   The catalog is visible for readers and employees. Readers can borrow a book
   when at least one book item is available.
</p>

<div class="toolbar">
   <select @bind="_searchField">
      <option value="Title">Title</option>
      <option value="AuthorLastName">Author last name</option>
      <option value="Isbn">ISBN</option>
   </select>
   <input placeholder="Search text" @bind="_searchText" />
   <button @onclick="SearchAsync">Search</button>
   <button @onclick="LoadAsync">Reset</button>
</div>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p>Loading books...</p>
}
else if(_books.Count == 0) {
   <p>No books found.</p>
}
else {
   <table>
      <thead>
         <tr>
            <th>Title</th>
            <th>Subtitle</th>
            <th>Authors</th>
            <th>ISBN</th>
            <th>Items</th>
            <th>Status</th>
            <th>Action</th>
         </tr>
      </thead>
      <tbody>
         @foreach(BookListItemDto book in _books) {
            <tr>
               <td>@book.Title</td>
               <td>@book.Subtitle</td>
               <td>@book.AuthorsText</td>
               <td>@book.Isbn</td>
               <td>@book.AvailableItems / @book.TotalItems</td>
               <td>@(book.IsActive ? "Active" : "Inactive")</td>
               <td>
                  @if(_currentUser.IsReader && book.AvailableItems > 0) {
                     <button @onclick="() => NavigateToBorrow(book.Id)">
                        Borrow
                     </button>
                  }
                  else if(_currentUser.IsReader) {
                     <span>Not available</span>
                  }
                  else if(_currentUser.IsEmployee) {
                     <span>Employee view</span>
                  }
                  else {
                     <span>No action</span>
                  }
               </td>
            </tr>
         }
      </tbody>
   </table>
}

@code {

   private IReadOnlyList<BookListItemDto> _books = [];

   private BookSearchField _searchField = BookSearchField.Title;

   private string? _searchText;

   private CurrentUserInfo? _currentUser;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();

      Result<IEnumerable<BookListItemDto>> result = await BookClient.GetAllAsync();

      if(result.IsSuccess && result.Value is not null)
         _books = result.Value.ToList();
      else
         Error = result.Error;

      StopLoading();
   }

   private async Task SearchAsync() {
      if(string.IsNullOrWhiteSpace(_searchText)) {
         await LoadAsync();
         return;
      }

      StartLoading();

      Result<IEnumerable<BookListItemDto>> result = await BookClient.SearchAsync(
         searchField: _searchField,
         searchText: _searchText
      );

      if(result.IsSuccess && result.Value is not null)
         _books = result.Value.ToList();
      else
         Error = result.Error;

      StopLoading();
   }

   private void NavigateToBorrow(Guid bookId) {
      Navigation.NavigateTo($"/catalog/books/{bookId}/borrow");
   }
}
