@page "/catalog/books"
@rendermode InteractiveServer
@inherits BasePage

@inject IBookClient BookClient
@inject ILoanClient LoanClient
@inject ICurrentUserProvider CurrentUserProvider
@inject NavigationManager Navigation

<PageTitle>Bücher</PageTitle>

<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
   @* <h1 class="h3 mb-0">Bücher</h1> *@

   @if (_currentUser?.IsEmployee == true) {
      <a class="btn btn-primary" href="/catalog/books/create">
         Buch hinzufügen
      </a>
   }
</div>

@* <p class="text-muted"> *@
@*    Der Katalog ist für Leserinnen, Leser und Mitarbeitende sichtbar. *@
@*    Leserinnen und Leser können ein Buch ausleihen, wenn mindestens ein Exemplar *@
@*    tatsächlich verfügbar ist. *@
@* </p> *@

<div class="row gy-2 gx-2 align-items-end mb-3">
   <div class="col-sm-auto">
      <label class="form-label small text-muted mb-1" for="searchField">Suchfeld</label>
      <select id="searchField" class="form-select" @bind="_searchField">
         <option value="Title">Titel</option>
         <option value="AuthorLastName">Nachname Autor/in</option>
         <option value="Isbn">ISBN</option>
      </select>
   </div>

   <div class="col-sm-4 col-md-3">
      <label class="form-label small text-muted mb-1" for="searchText">Suchtext</label>
      <input id="searchText" class="form-control" placeholder="Suchtext" @bind="_searchText"/>
   </div>

   <div class="col-sm-auto d-flex gap-2">
      <button class="btn btn-primary" @onclick="SearchAsync">Suchen</button>
      <button class="btn btn-outline-secondary" @onclick="LoadAsync">Zurücksetzen</button>
   </div>
</div>

<ErrorAlert Error="Error"/>

@if (IsLoading || _currentUser is null) {
   <p class="text-muted">Bücher werden geladen...</p>
}
else if(Error is not null) {
   @* ErrorAlert above displays the API error. *@
}
else if (_books.Count == 0) {
   <p>Keine Bücher gefunden.</p>
}
else {
   <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
         <thead class="table-light">
         <tr>
            <th scope="col" class="text-nowrap">Aktion</th>
            <th scope="col">Titel</th>
            <th scope="col">Autorinnen/Autoren</th>
            <th scope="col" class="text-nowrap">ISBN</th>
            <th scope="col"
                class="text-nowrap"
                title="Ausgeliehen / Gesamt">
               Exemplare
            </th>
            <th scope="col" class="text-nowrap">Status</th>
         </tr>
         </thead>

         <tbody>
         @foreach (BookDto book in _books) {
            BookAvailability availability = GetAvailability(book);

            <tr>
               <td class="text-nowrap">
                  @if (_currentUser.IsReader && availability.BorrowedByCurrentReader) {
                     <span class="text-muted">Bereits ausgeliehen</span>
                  }
                  else if (_currentUser.IsReader && book.IsActive && availability.AvailableItems > 0) {
                     <button class="btn btn-primary btn-sm"
                             @onclick="() => NavigateToBorrow(book.Id)">
                        Ausleihen
                     </button>
                  }
                  else if (_currentUser.IsReader) {
                     <span class="text-muted">Nicht verfügbar</span>
                  }
                  else if (_currentUser.IsEmployee && book.IsActive) {
                     <div class="d-flex flex-wrap gap-1">
                        <a class="btn btn-outline-primary btn-sm"
                           title="Exemplar hinzufügen"
                           href="@($"/catalog/books/{book.Id}/items/add")">
                           Exemplar
                        </a>

                        <a class="btn btn-outline-danger btn-sm"
                           title="Buch deaktivieren"
                           href="@($"/catalog/books/{book.Id}/deactivate")">
                           Deaktivieren
                        </a>
                     </div>
                  }
                  else if (_currentUser.IsEmployee) {
                     <span class="text-muted">Keine Aktion</span>
                  }
                  else {
                     <span class="text-muted">Keine Aktion</span>
                  }
               </td>

               <td>
                  <div style="max-width: 20rem;">
                     <div class="fw-semibold text-truncate"
                          title="@book.Title">
                        @book.Title
                     </div>

                     @if (!string.IsNullOrWhiteSpace(book.Subtitle)) {
                        <div class="small text-muted text-truncate"
                             title="@book.Subtitle">
                           @book.Subtitle
                        </div>
                     }
                  </div>
               </td>

               <td>
                  <div class="text-truncate"
                       style="max-width: 18rem;"
                       title="@book.AuthorsText">
                     @book.AuthorsText
                  </div>
               </td>

               <td class="text-nowrap">
                  @book.Isbn
               </td>

               <td class="text-nowrap"
                   title="Ausgeliehen / Gesamt">
                  @availability.BorrowedItems / @availability.TotalItems
               </td>

               <td class="text-nowrap">
                  @if (book.IsActive) {
                     <span class="badge text-bg-success">Aktiv</span>
                  }
                  else {
                     <span class="badge text-bg-secondary">Inaktiv</span>
                  }
               </td>
            </tr>
         }
         </tbody>
      </table>
   </div>
}

@code {

   private const int AvailableBookItemStatus = 1;

   private IReadOnlyList<BookDto> _books = [];

   private readonly Dictionary<Guid, BookAvailability> _availabilityByBookId = new();

   private BookSearchField _searchField = BookSearchField.Title;

   private string? _searchText;

   private CurrentUserInfo? _currentUser;

   private bool IncludeInactiveBooks =>
      _currentUser?.IsEmployee == true;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();

      await LoadAsync();
   }

   private async Task LoadAsync() {
      StartLoading();
      Error = null;

      Result<IEnumerable<BookDto>> result = await BookClient.GetAllAsync(
         includeInactive: IncludeInactiveBooks
      );

      if (result.IsSuccess && result.Value is not null) {
         _books = result.Value.ToList();
         await RefreshAvailabilityAsync();
      }
      else {
         Error = result.Error;
      }

      StopLoading();
   }

   private async Task SearchAsync() {
      if (string.IsNullOrWhiteSpace(_searchText)) {
         await LoadAsync();
         return;
      }

      StartLoading();
      Error = null;

      Result<IEnumerable<BookDto>> result = await BookClient.SearchAsync(
         searchField: _searchField,
         searchText: _searchText,
         includeInactive: IncludeInactiveBooks
      );

      if (result.IsSuccess && result.Value is not null) {
         _books = result.Value.ToList();
         await RefreshAvailabilityAsync();
      }
      else {
         Error = result.Error;
      }

      StopLoading();
   }

   private async Task RefreshAvailabilityAsync() {
      _availabilityByBookId.Clear();

      Result<IEnumerable<LoanDto>> loanResult = await LoanClient.GetBorrowedAsync();

      if(loanResult.IsFailure || loanResult.Value is null) {
         Error = loanResult.Error;
         return;
      }

      IReadOnlyList<LoanDto> borrowedLoans =
         loanResult.Value.ToList();

      HashSet<Guid> borrowedBookItemIds = borrowedLoans
         .Select(loan => loan.BookItemId)
         .ToHashSet();

      HashSet<Guid> currentReaderBorrowedBookItemIds = [];

      if(_currentUser?.IsReader == true) {
         Result<IEnumerable<LoanDto>> myLoansResult =
            await LoanClient.GetMyBorrowedAsync();

         if(myLoansResult.IsFailure || myLoansResult.Value is null) {
            Error = myLoansResult.Error;
            return;
         }

         currentReaderBorrowedBookItemIds = myLoansResult.Value
            .Select(loan => loan.BookItemId)
            .ToHashSet();
      }

      foreach (BookDto book in _books) {
         Result<BookDto> detailResult = await BookClient.GetByIdAsync(
            id: book.Id,
            includeInactive: IncludeInactiveBooks
         );

         if (detailResult.IsFailure || detailResult.Value is null) {
            _availabilityByBookId[book.Id] = CreateFallbackAvailability(book);
            continue;
         }

         IReadOnlyList<BookItemDto> bookItems = detailResult.Value.BookItems ?? [];

         int totalItems = bookItems.Count;

         if (totalItems == 0)
            totalItems = book.TotalItems;

         int availableItems = bookItems.Count(item =>
            item.Status == AvailableBookItemStatus &&
            !borrowedBookItemIds.Contains(item.Id)
         );

         bool borrowedByCurrentReader = bookItems.Any(item =>
            currentReaderBorrowedBookItemIds.Contains(item.Id)
         );

         int borrowedItems = Math.Max(
            val1: 0,
            val2: totalItems - availableItems
         );

         _availabilityByBookId[book.Id] = new BookAvailability(
            TotalItems: totalItems,
            BorrowedItems: borrowedItems,
            AvailableItems: availableItems,
            BorrowedByCurrentReader: borrowedByCurrentReader
         );
      }
   }

   private BookAvailability GetAvailability(
      BookDto book
   ) => _availabilityByBookId.TryGetValue(
      key: book.Id,
      value: out BookAvailability? availability
   )
      ? availability
      : CreateFallbackAvailability(book);

   private static BookAvailability CreateFallbackAvailability(
      BookDto book
   ) {
      int totalItems = book.TotalItems;
      int availableItems = Math.Clamp(
         value: book.AvailableItems,
         min: 0,
         max: totalItems
      );
      int borrowedItems = Math.Max(
         val1: 0,
         val2: totalItems - availableItems
      );

      return new BookAvailability(
         TotalItems: totalItems,
         BorrowedItems: borrowedItems,
         AvailableItems: availableItems,
         BorrowedByCurrentReader: false
      );
   }

   private void NavigateToBorrow(Guid bookId) {
      Navigation.NavigateTo($"/catalog/books/{bookId}/borrow");
   }

   private sealed record BookAvailability(
      int TotalItems,
      int BorrowedItems,
      int AvailableItems,
      bool BorrowedByCurrentReader
   );

}
