@page "/catalog/books/{BookId:guid}/deactivate"
@attribute [Authorize(Roles = CampusLibraryRoles.Employee)]
@rendermode InteractiveServer
@inherits BasePage

@inject IBookClient BookClient
@inject ICurrentUserProvider CurrentUserProvider
@inject NavigationManager Navigation

<PageTitle>Buch deaktivieren</PageTitle>

<h1 class="h3 mb-3">Buch deaktivieren</h1>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p class="text-muted">Buchdaten werden geladen...</p>
}
else if(!_currentUser.IsEmployee) {
   <div class="alert alert-warning" role="alert">
      Diese Seite ist für Mitarbeitende vorgesehen.
   </div>

   <button class="btn btn-outline-secondary" @onclick="BackToCatalog">
      Zurück zum Katalog
   </button>
}
else if(_book is null) {
   <p>Buch nicht gefunden.</p>

   <button class="btn btn-outline-secondary" @onclick="BackToCatalog">
      Zurück zum Katalog
   </button>
}
else {
   @if(_deactivated) {
      <div class="alert alert-success" role="alert">
         Das Buch wurde deaktiviert.
      </div>
   }

   <div class="card shadow-sm mb-3">
      <div class="card-body">
         <h2 class="h5 card-title mb-3">Buch</h2>

         <dl class="row mb-0">
            <dt class="col-sm-3">Titel</dt>
            <dd class="col-sm-9">@Display(_book.Title)</dd>

            <dt class="col-sm-3">Untertitel</dt>
            <dd class="col-sm-9">@Display(_book.Subtitle)</dd>

            <dt class="col-sm-3">Autorinnen/Autoren</dt>
            <dd class="col-sm-9">@Display(_book.AuthorsText)</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@Display(_book.Isbn)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
               @if(_book.IsActive) {
                  <span class="badge text-bg-success">Aktiv</span>
               }
               else {
                  <span class="badge text-bg-secondary">Inaktiv</span>
               }
            </dd>

            <dt class="col-sm-3">Exemplare insgesamt</dt>
            <dd class="col-sm-9">@CurrentItemCount</dd>

            <dt class="col-sm-3">Davon ausgeliehen</dt>
            <dd class="col-sm-9">
               @if(BorrowedItemCount > 0) {
                  <span class="badge text-bg-danger">@BorrowedItemCount</span>
               }
               else {
                  <span class="badge text-bg-success">0</span>
               }
            </dd>
         </dl>
      </div>
   </div>

   @if(_book.IsActive) {
      @if(BorrowedItemCount > 0) {
         <div class="alert alert-danger" role="alert">
            Das Buch kann derzeit nicht deaktiviert werden, weil
            @BorrowedItemCount @BorrowedItemLabel ausgeliehen.
         </div>

         <div class="card shadow-sm mb-3">
            <div class="card-body">
               <h2 class="h5 card-title mb-3">Aktuelle Ausleihen</h2>

               <div class="table-responsive">
                  <table class="table table-sm align-middle mb-0">
                     <thead>
                     <tr>
                        <th scope="col">Reader-E-Mail</th>
                        <th scope="col">Fällig am</th>
                     </tr>
                     </thead>
                     <tbody>
                     @foreach(BookLoanInfoDto loan in CurrentLoans) {
                        <tr>
                           <td>@loan.ReaderEmail</td>
                           <td>@loan.DueDate.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        </tr>
                     }
                     </tbody>
                  </table>
               </div>
            </div>
         </div>
      }
      else {
         <div class="alert alert-warning" role="alert">
            Bei erfolgreicher Deaktivierung werden alle zugehörigen Exemplare
            dauerhaft gelöscht.
         </div>
      }

      <div class="d-flex flex-wrap gap-2">
         <button
            class="btn btn-danger"
            @onclick="DeactivateAsync"
            disabled="@(!CanDeactivate || IsLoading)">
            Buch deaktivieren
         </button>

         <button class="btn btn-outline-secondary" @onclick="BackToCatalog">
            Abbrechen
         </button>
      </div>
   }
   else {
      <p class="text-muted">Dieses Buch ist bereits inaktiv.</p>

      <button class="btn btn-outline-secondary" @onclick="BackToCatalog">
         Zurück zum Katalog
      </button>
   }
}

@code {

   [Parameter]
   public Guid BookId { get; set; }

   private CurrentUserInfo? _currentUser;

   private BookDto? _book;

   private BookDeactivationInfoDto? _deactivationInfo;

   private bool _deactivated;

   private IReadOnlyList<BookItemDto> CurrentItems =>
      _book?.BookItems ?? [];

   private IReadOnlyList<BookLoanInfoDto> CurrentLoans =>
      _deactivationInfo?.CurrentLoans ?? [];

   private int CurrentItemCount =>
      _deactivationInfo?.TotalItems ??
      (CurrentItems.Count > 0
         ? CurrentItems.Count
         : _book?.TotalItems ?? 0);

   private int BorrowedItemCount =>
      _deactivationInfo?.BorrowedItems ?? 0;

   private bool CanDeactivate =>
      _book?.IsActive == true &&
      _deactivationInfo is not null &&
      BorrowedItemCount == 0;

   private string BorrowedItemLabel =>
      BorrowedItemCount == 1
         ? "Exemplar ist"
         : "Exemplare sind";

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadPageAsync();
   }

   private async Task LoadPageAsync() {
      StartLoading();
      Error = null;

      Result<BookDto> bookResult = await BookClient.GetByIdAsync(
         id: BookId,
         includeInactive: true
      );

      if(bookResult.IsFailure || bookResult.Value is null) {
         Error = bookResult.Error;
         StopLoading();
         return;
      }

      _book = bookResult.Value;

      if(_currentUser?.IsEmployee == true) {
         Result<BookDeactivationInfoDto> infoResult =
            await BookClient.GetDeactivationInfoAsync(
               bookId: BookId
            );

         if(infoResult.IsFailure || infoResult.Value is null) {
            Error = infoResult.Error;
            StopLoading();
            return;
         }

         _deactivationInfo = infoResult.Value;
      }

      StopLoading();
   }

   private async Task DeactivateAsync() {
      if(_currentUser?.IsEmployee != true || !CanDeactivate)
         return;

      StartLoading();
      Error = null;

      Result<BookDto> result = await BookClient.DeactivateAsync(
         bookId: BookId
      );

      if(result.IsFailure) {
         var deactivateError = result.Error;
         StopLoading();
         await LoadPageAsync();
         Error = deactivateError;
         return;
      }

      _deactivated = true;
      await LoadPageAsync();
   }

   private void BackToCatalog() {
      Navigation.NavigateTo("/catalog/books");
   }

   private static string Display(
      string? value
   ) => string.IsNullOrWhiteSpace(value)
      ? "Nicht verfügbar"
      : value;
}
