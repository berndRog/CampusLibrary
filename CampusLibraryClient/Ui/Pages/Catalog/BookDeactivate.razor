@page "/catalog/books/{BookId:guid}/deactivate"
@rendermode InteractiveServer
@inherits BasePage

@inject IBookClient BookClient
@inject ICurrentUserProvider CurrentUserProvider
@inject NavigationManager Navigation

<PageTitle>Buch deaktivieren</PageTitle>

<h1 class="h3 mb-3">Buch deaktivieren</h1>

<ErrorAlert Error="Error" />

@if(IsLoading || _currentUser is null) {
   <p class="text-muted">Buchdaten werden geladen...</p>
}
else if(!_currentUser.IsEmployee) {
   <div class="alert alert-warning" role="alert">
      Diese Seite ist für Mitarbeitende vorgesehen.
   </div>

   <button class="btn btn-outline-secondary" @onclick="BackToCatalog">
      Zurück zum Katalog
   </button>
}
else if(_book is null) {
   <p>Buch nicht gefunden.</p>

   <button class="btn btn-outline-secondary" @onclick="BackToCatalog">
      Zurück zum Katalog
   </button>
}
else {
   @if(_deactivated) {
      <div class="alert alert-success" role="alert">
         Das Buch wurde deaktiviert.
      </div>
   }

   <div class="card shadow-sm mb-3">
      <div class="card-body">
         <h2 class="h5 card-title mb-3">Buch</h2>

         <dl class="row mb-0">
            <dt class="col-sm-3">Titel</dt>
            <dd class="col-sm-9">@Display(_book.Title)</dd>

            <dt class="col-sm-3">Untertitel</dt>
            <dd class="col-sm-9">@Display(_book.Subtitle)</dd>

            <dt class="col-sm-3">Autorinnen/Autoren</dt>
            <dd class="col-sm-9">@Display(_book.AuthorsText)</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@Display(_book.Isbn)</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
               @if(_book.IsActive) {
                  <span class="badge text-bg-success">Aktiv</span>
               }
               else {
                  <span class="badge text-bg-secondary">Inaktiv</span>
               }
            </dd>

            <dt class="col-sm-3">Exemplare</dt>
            <dd class="col-sm-9">@CurrentItemCount</dd>
         </dl>
      </div>
   </div>

   @if(_book.IsActive) {
      <div class="alert alert-warning" role="alert">
         Das Buch wird deaktiviert. Die zugehörigen Exemplare werden gemäß
         API-Use-Case entfernt beziehungsweise stehen anschließend nicht mehr
         für neue Ausleihen zur Verfügung.
      </div>

      <div class="d-flex flex-wrap gap-2">
         <button class="btn btn-danger" @onclick="DeactivateAsync" disabled="@IsLoading">
            Buch deaktivieren
         </button>

         <button class="btn btn-outline-secondary" @onclick="BackToCatalog">
            Abbrechen
         </button>
      </div>
   }
   else {
      <p class="text-muted">Dieses Buch ist bereits inaktiv.</p>

      <button class="btn btn-outline-secondary" @onclick="BackToCatalog">
         Zurück zum Katalog
      </button>
   }
}

@code {

   [Parameter]
   public Guid BookId { get; set; }

   private CurrentUserInfo? _currentUser;

   private BookDetailDto? _book;

   private bool _deactivated;

   private IReadOnlyList<BookItemDto> CurrentItems =>
      _book?.BookItems ?? [];

   private int CurrentItemCount =>
      CurrentItems.Count > 0
         ? CurrentItems.Count
         : _book?.TotalItems ?? 0;

   protected override async Task OnInitializedAsync() {
      _currentUser = await CurrentUserProvider.GetCurrentUserAsync();
      await LoadBookAsync();
   }

   private async Task LoadBookAsync() {
      StartLoading();
      Error = null;

      Result<BookDetailDto> result = await BookClient.GetByIdAsync(
         id: BookId,
         includeInactive: true
      );

      if(result.IsSuccess && result.Value is not null)
         _book = result.Value;
      else
         Error = result.Error;

      StopLoading();
   }

   private async Task DeactivateAsync() {
      if(_currentUser?.IsEmployee != true || _book?.IsActive != true)
         return;

      StartLoading();
      Error = null;

      Result<BookDto> result = await BookClient.DeactivateAsync(
         bookId: BookId
      );

      if(result.IsFailure) {
         Error = result.Error;
         StopLoading();
         return;
      }

      _deactivated = true;
      await LoadBookAsync();
   }

   private void BackToCatalog() {
      Navigation.NavigateTo("/catalog/books");
   }

   private static string Display(
      string? value
   ) => string.IsNullOrWhiteSpace(value)
      ? "Nicht verfügbar"
      : value;
}
